    }
    state st_parse_ipv4 {
        pkt.extract(hdr.ipv4_s0);
        transition select((bit<64>)hdr.ipv4_s0.protocol) {
            64w1: st_parse_icmp;
            64w6: st_parse_tcp;
            64w17: st_parse_udp;
            default: accept;
