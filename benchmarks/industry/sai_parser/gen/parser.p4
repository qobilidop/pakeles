    state st_parse_vlan {
        pkt.extract(hdr.vlan_s0);
        transition select((bit<64>)hdr.vlan_s0.ether_type) {
            64w2048: st_parse_ipv4;
            64w34525: st_parse_ipv6;
            64w2054: st_parse_arp;
            default: accept;
