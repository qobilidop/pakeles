    state st_parse_ethernet {
        pkt.extract(hdr.ethernet_s0);
        transition select((bit<64>)hdr.ethernet_s0.ether_type) {
            64w2048: st_parse_ipv4;
            64w34525: st_parse_ipv6;
            64w2054: st_parse_arp;
            64w33024: st_parse_vlan;
            default: accept;
