digraph "dash_parser" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "parse_u0_ethernet" [shape=box, label="parse_u0_ethernet\nextract u0_ethernet", tooltip="The source's `start` state (the eDSL reserves that name):\nu0 EtherType demux, incl. the DASH packet-metadata sentinel\n0x876d; every miss accepts.", href="#"];
  "parse_dash_hdr" [shape=box, label="parse_dash_hdr\nextract packet_meta", tooltip="The wire packet_meta overwrites start's defaults; the\nsubtype demux routes FLOW_{CREATE,UPDATE,DELETE} through\nflow_key (the source's first parser `if`), everything else\nstraight to the customer layer.", href="#"];
  "parse_flow_key" [shape=box, label="parse_flow_key\nextract flow_key", tooltip="CREATE/UPDATE stop at the key; DELETE carries flow_data\n(the source's second parser `if`, re-keyed on the already-\nextracted subtype).", href="#"];
  "parse_flow_data" [shape=box, label="parse_flow_data\nextract flow_data", tooltip="The DELETE `if` cascade over flow_data.actions as one\nfirst-match select: actions == 0 -> nothing extra; otherwise\nflow_overlay_data always, plus the encap header per ENCAP_U0/\nENCAP_U1 bit (masked arms over the low two bits).", href="#"];
  "parse_flow_overlay_data" [shape=box, label="parse_flow_overlay_data\nextract flow_overlay_data", tooltip="actions != 0 with neither encap bit: overlay data only.", href="#"];
  "parse_flow_encap_u0" [shape=box, label="parse_flow_encap_u0\nextract flow_overlay_data\nextract flow_u0_encap_data"];
  "parse_flow_encap_u1" [shape=box, label="parse_flow_encap_u1\nextract flow_overlay_data\nextract flow_u1_encap_data"];
  "parse_flow_encap_u0_u1" [shape=box, label="parse_flow_encap_u0_u1\nextract flow_overlay_data\nextract flow_u0_encap_data\nextract flow_u1_encap_data"];
  "parse_u0_ipv4" [shape=box, label="parse_u0_ipv4\nextract u0_ipv4", tooltip="verify(version == 4, IPv4IncorrectVersion) — the source\nchecks version before IHL, so a bad version wins.", href="#"];
  "parse_u0_ipv4_ihl" [shape=box, label="parse_u0_ipv4_ihl", tooltip="verify(ihl >= 5, InvalidIPv4Header), then the source's IHL\nselect: 5 -> dispatch, > 5 -> the options varbit.", href="#"];
  "parse_u0_ipv4options" [shape=box, label="parse_u0_ipv4options\nextract u0_ipv4options"];
  "dispatch_on_u0_protocol" [shape=box, label="dispatch_on_u0_protocol", tooltip="The source's own dispatch state (shared by the ihl=5 and\noptions paths); a protocol miss accepts.", href="#"];
  "parse_u0_ipv6" [shape=box, label="parse_u0_ipv6\nextract u0_ipv6", tooltip="next_header straight to L4 — no extension-header walk.", href="#"];
  "parse_u0_udp" [shape=box, label="parse_u0_udp\nextract u0_udp", tooltip="dst_port 4789 opens VXLAN — on UDP only (TCP port 4789\nstays plain TCP), and only at the u0 layer.", href="#"];
  "parse_u0_tcp" [shape=box, label="parse_u0_tcp\nextract u0_tcp"];
  "parse_u0_vxlan" [shape=box, label="parse_u0_vxlan\nextract u0_vxlan"];
  "parse_customer_ethernet" [shape=box, label="parse_customer_ethernet\nextract customer_ethernet", tooltip="The customer layer has no DASH-sentinel and no VXLAN arm:\n0x876d or a nested encap inside the overlay just accepts.", href="#"];
  "parse_customer_ipv4" [shape=box, label="parse_customer_ipv4\nextract customer_ipv4"];
  "parse_customer_ipv4_ihl" [shape=box, label="parse_customer_ipv4_ihl", tooltip="verify(ihl == 5, IPv4OptionsNotSupported): the customer\nlayer refuses options outright (unlike u0's varbit).", href="#"];
  "dispatch_on_customer_protocol" [shape=box, label="dispatch_on_customer_protocol"];
  "parse_customer_ipv6" [shape=box, label="parse_customer_ipv6\nextract customer_ipv6"];
  "parse_customer_udp" [shape=box, label="parse_customer_udp\nextract customer_udp"];
  "parse_customer_tcp" [shape=box, label="parse_customer_tcp\nextract customer_tcp"];
  "accept" [shape=doublecircle];
  "reject_0" [shape=diamond, label="reject:\nIPv4IncorrectVersion"];
  "reject_1" [shape=diamond, label="reject:\nInvalidIPv4Header"];
  "reject_2" [shape=diamond, label="reject:\nIPv4OptionsNotSupported"];
  "parse_u0_ethernet" -> "parse_u0_ipv4" [label="u0_ethernet.ether_type == 0x800"];
  "parse_u0_ethernet" -> "parse_u0_ipv6" [label="u0_ethernet.ether_type == 0x86dd"];
  "parse_u0_ethernet" -> "parse_dash_hdr" [label="u0_ethernet.ether_type == 0x876d"];
  "parse_u0_ethernet" -> "accept" [label="default", style=dashed];
  "parse_dash_hdr" -> "parse_flow_key" [label="packet_meta.packet_subtype == 0x1"];
  "parse_dash_hdr" -> "parse_flow_key" [label="packet_meta.packet_subtype == 0x2"];
  "parse_dash_hdr" -> "parse_flow_key" [label="packet_meta.packet_subtype == 0x3"];
  "parse_dash_hdr" -> "parse_customer_ethernet" [label="default", style=dashed];
  "parse_flow_key" -> "parse_flow_data" [label="packet_meta.packet_subtype == 0x3"];
  "parse_flow_key" -> "parse_customer_ethernet" [label="default", style=dashed];
  "parse_flow_data" -> "parse_customer_ethernet" [label="flow_data.actions == 0x0"];
  "parse_flow_data" -> "parse_flow_encap_u0_u1" [label="flow_data.actions & 0x3 == 0x3"];
  "parse_flow_data" -> "parse_flow_encap_u0" [label="flow_data.actions & 0x3 == 0x1"];
  "parse_flow_data" -> "parse_flow_encap_u1" [label="flow_data.actions & 0x3 == 0x2"];
  "parse_flow_data" -> "parse_flow_overlay_data" [label="default", style=dashed];
  "parse_flow_overlay_data" -> "parse_customer_ethernet";
  "parse_flow_encap_u0" -> "parse_customer_ethernet";
  "parse_flow_encap_u1" -> "parse_customer_ethernet";
  "parse_flow_encap_u0_u1" -> "parse_customer_ethernet";
  "parse_u0_ipv4" -> "parse_u0_ipv4_ihl" [label="u0_ipv4.version == 0x4"];
  "parse_u0_ipv4" -> "reject_0" [label="default", style=dashed];
  "parse_u0_ipv4_ihl" -> "reject_1" [label="u0_ipv4.ihl in 0x0..=0x4"];
  "parse_u0_ipv4_ihl" -> "dispatch_on_u0_protocol" [label="u0_ipv4.ihl == 0x5"];
  "parse_u0_ipv4_ihl" -> "parse_u0_ipv4options" [label="default", style=dashed];
  "parse_u0_ipv4options" -> "dispatch_on_u0_protocol";
  "dispatch_on_u0_protocol" -> "parse_u0_udp" [label="u0_ipv4.protocol == 0x11"];
  "dispatch_on_u0_protocol" -> "parse_u0_tcp" [label="u0_ipv4.protocol == 0x6"];
  "dispatch_on_u0_protocol" -> "accept" [label="default", style=dashed];
  "parse_u0_ipv6" -> "parse_u0_udp" [label="u0_ipv6.next_header == 0x11"];
  "parse_u0_ipv6" -> "parse_u0_tcp" [label="u0_ipv6.next_header == 0x6"];
  "parse_u0_ipv6" -> "accept" [label="default", style=dashed];
  "parse_u0_udp" -> "parse_u0_vxlan" [label="u0_udp.dst_port == 0x12b5"];
  "parse_u0_udp" -> "accept" [label="default", style=dashed];
  "parse_u0_tcp" -> "accept";
  "parse_u0_vxlan" -> "parse_customer_ethernet";
  "parse_customer_ethernet" -> "parse_customer_ipv4" [label="customer_ethernet.ether_type == 0x800"];
  "parse_customer_ethernet" -> "parse_customer_ipv6" [label="customer_ethernet.ether_type == 0x86dd"];
  "parse_customer_ethernet" -> "accept" [label="default", style=dashed];
  "parse_customer_ipv4" -> "parse_customer_ipv4_ihl" [label="customer_ipv4.version == 0x4"];
  "parse_customer_ipv4" -> "reject_0" [label="default", style=dashed];
  "parse_customer_ipv4_ihl" -> "dispatch_on_customer_protocol" [label="customer_ipv4.ihl == 0x5"];
  "parse_customer_ipv4_ihl" -> "reject_2" [label="default", style=dashed];
  "dispatch_on_customer_protocol" -> "parse_customer_udp" [label="customer_ipv4.protocol == 0x11"];
  "dispatch_on_customer_protocol" -> "parse_customer_tcp" [label="customer_ipv4.protocol == 0x6"];
  "dispatch_on_customer_protocol" -> "accept" [label="default", style=dashed];
  "parse_customer_ipv6" -> "parse_customer_udp" [label="customer_ipv6.next_header == 0x11"];
  "parse_customer_ipv6" -> "parse_customer_tcp" [label="customer_ipv6.next_header == 0x6"];
  "parse_customer_ipv6" -> "accept" [label="default", style=dashed];
  "parse_customer_udp" -> "accept";
  "parse_customer_tcp" -> "accept";
}
