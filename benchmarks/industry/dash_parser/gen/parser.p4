        else if (smeta.parser_error == error.ParserTimeout) { err = 8w5; }
        else if (smeta.parser_error == error.ParserInvalidArgument) { err = 8w6; }
        hdr.verdict.err = err;
        smeta.egress_spec = 9w1;
