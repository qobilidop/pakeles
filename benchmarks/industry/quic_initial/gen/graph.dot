digraph "quic_initial" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "parse_first" [shape=box, label="parse_first\nextract first_byte", tooltip="Header form bit routes short vs long; the rest of the first\nbyte rides along (type bits meaningful only for long headers).", href="#"];
  "short_accept" [shape=box, label="short_accept", tooltip="Classify-only: the short-header DCID length is out-of-band\nLB configuration (the katran-config-gate analog).", href="#"];
  "parse_version" [shape=box, label="parse_version\nextract version", tooltip="Version routes v1 (deep parse) vs VN vs unknown; RFC 8999\ninvariants guarantee CIDs follow in every case.", href="#"];
  "vn_mark" [shape=box, label="vn_mark", tooltip="Version list deliberately not walked (quinn's stance; quiche\nwalks it - documented divergence).", href="#"];
  "unknown_mark" [shape=box, label="unknown_mark", tooltip="Unknown versions parse through (quiche's stance; quinn\nrejects with UnsupportedVersion after the CIDs).", href="#"];
  "parse_other_cids" [shape=box, label="parse_other_cids\nextract other_cids", tooltip="Non-v1 CIDs are uncapped: quiche enforces the 20-byte cap\nonly for versions it supports.", href="#"];
  "parse_dcid_len" [shape=box, label="parse_dcid_len\nextract dcid_len", tooltip="The v1 cap check sits between the length byte and the CID\nbytes, mirroring quiche's check-before-read order.", href="#"];
  "parse_dcid" [shape=box, label="parse_dcid\nextract dcid"];
  "parse_scid_len" [shape=box, label="parse_scid_len\nextract scid_len"];
  "parse_scid" [shape=box, label="parse_scid\nextract scid", tooltip="CIDs done; the long-type bits pick the tail grammar.", href="#"];
  "initial_mark" [shape=box, label="initial_mark"];
  "zero_rtt_mark" [shape=box, label="zero_rtt_mark", tooltip="No token by grammar; straight to the length varint (quinn's\nparse extent - quiche stops after the SCID here).", href="#"];
  "handshake_mark" [shape=box, label="handshake_mark"];
  "retry_accept" [shape=box, label="retry_accept", tooltip="Classify-only: the Retry token is 'rest minus 16-byte tag',\nwhich needs remaining()-16 as a byte length - banned in v1\n(named boundary, see the charter).", href="#"];
  "parse_tok_lead" [shape=box, label="parse_tok_lead\nextract tok_lead", tooltip="The self-sizing varint, arm 1 of 2: token length. The 2-bit\nprefix is an ordinary fixed field; each width arm re-composes\nthe value inline because var-width fields cannot cross the\narms' join (see the design doc's three walls).", href="#"];
  "tok_w1" [shape=box, label="tok_w1\nextract tok0"];
  "tok_w2" [shape=box, label="tok_w2\nextract tok1"];
  "tok_w4" [shape=box, label="tok_w4\nextract tok2"];
  "tok_w8" [shape=box, label="tok_w8\nextract tok3"];
  "parse_len_lead" [shape=box, label="parse_len_lead\nextract len_lead", tooltip="The self-sizing varint, arm 2 of 2: payload length. Shared\nby Initial, 0-RTT, and Handshake (kind already in metadata);\nthe value is observed, not consumed - parsing stops before the\nprotected packet number.", href="#"];
  "len_w1" [shape=box, label="len_w1"];
  "len_w2" [shape=box, label="len_w2\nextract len1"];
  "len_w4" [shape=box, label="len_w4\nextract len2"];
  "len_w8" [shape=box, label="len_w8\nextract len3"];
  "accept" [shape=doublecircle];
  "reject_0" [shape=diamond, label="reject:\nunreachable: 1-bit key"];
  "reject_1" [shape=diamond, label="reject:\ndcid too long for v1"];
  "reject_2" [shape=diamond, label="reject:\nscid too long for v1"];
  "reject_3" [shape=diamond, label="reject:\nunreachable: 2-bit key"];
  "parse_first" -> "short_accept" [label="first_byte.form == 0x0"];
  "parse_first" -> "parse_version" [label="first_byte.form == 0x1"];
  "parse_first" -> "reject_0" [label="default", style=dashed];
  "short_accept" -> "accept";
  "parse_version" -> "parse_dcid_len" [label="version.v == 0x1"];
  "parse_version" -> "vn_mark" [label="version.v == 0x0"];
  "parse_version" -> "unknown_mark" [label="default", style=dashed];
  "vn_mark" -> "parse_other_cids";
  "unknown_mark" -> "parse_other_cids";
  "parse_other_cids" -> "accept";
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x0"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x1"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x2"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x3"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x4"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x5"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x6"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x7"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x8"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x9"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0xa"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0xb"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0xc"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0xd"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0xe"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0xf"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x10"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x11"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x12"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x13"];
  "parse_dcid_len" -> "parse_dcid" [label="dcid_len.ln == 0x14"];
  "parse_dcid_len" -> "reject_1" [label="default", style=dashed];
  "parse_dcid" -> "parse_scid_len";
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x0"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x1"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x2"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x3"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x4"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x5"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x6"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x7"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x8"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x9"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0xa"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0xb"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0xc"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0xd"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0xe"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0xf"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x10"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x11"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x12"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x13"];
  "parse_scid_len" -> "parse_scid" [label="scid_len.ln == 0x14"];
  "parse_scid_len" -> "reject_2" [label="default", style=dashed];
  "parse_scid" -> "initial_mark" [label="first_byte.ty == 0x0"];
  "parse_scid" -> "zero_rtt_mark" [label="first_byte.ty == 0x1"];
  "parse_scid" -> "handshake_mark" [label="first_byte.ty == 0x2"];
  "parse_scid" -> "retry_accept" [label="first_byte.ty == 0x3"];
  "parse_scid" -> "reject_3" [label="default", style=dashed];
  "initial_mark" -> "parse_tok_lead";
  "zero_rtt_mark" -> "parse_len_lead";
  "handshake_mark" -> "parse_len_lead";
  "retry_accept" -> "accept";
  "parse_tok_lead" -> "tok_w1" [label="tok_lead.prefix == 0x0"];
  "parse_tok_lead" -> "tok_w2" [label="tok_lead.prefix == 0x1"];
  "parse_tok_lead" -> "tok_w4" [label="tok_lead.prefix == 0x2"];
  "parse_tok_lead" -> "tok_w8" [label="tok_lead.prefix == 0x3"];
  "parse_tok_lead" -> "reject_3" [label="default", style=dashed];
  "tok_w1" -> "parse_len_lead";
  "tok_w2" -> "parse_len_lead";
  "tok_w4" -> "parse_len_lead";
  "tok_w8" -> "parse_len_lead";
  "parse_len_lead" -> "len_w1" [label="len_lead.prefix == 0x0"];
  "parse_len_lead" -> "len_w2" [label="len_lead.prefix == 0x1"];
  "parse_len_lead" -> "len_w4" [label="len_lead.prefix == 0x2"];
  "parse_len_lead" -> "len_w8" [label="len_lead.prefix == 0x3"];
  "parse_len_lead" -> "reject_3" [label="default", style=dashed];
  "len_w1" -> "accept";
  "len_w2" -> "accept";
  "len_w4" -> "accept";
  "len_w8" -> "accept";
}
