digraph "tls_clienthello" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "s_record" [shape=box, label="s_record\nextract record_hdr", tooltip="Record layer: 0x16 = handshake; the record length bounds\neverything (pushed before the select fires, harmlessly so on\nthe reject arm).", href="#"];
  "s_recver" [shape=box, label="s_recver", tooltip="rustls validates the record-layer version at parse time\n(InvalidMessage(UnknownProtocolVersion)); found by symex\nwitness replay, not by the hand-written corpus.", href="#"];
  "s_hs" [shape=box, label="s_hs\nextract handshake_hdr", tooltip="Handshake header: 0x01 = client_hello; hlen must fit the\nrecord (structural push check).", href="#"];
  "s_fixed" [shape=box, label="s_fixed\nextract body_fixed"];
  "s_sid_len" [shape=box, label="s_sid_len\nextract sid_len", tooltip="legacy_session_id: opaque <0..32>.", href="#"];
  "s_sid" [shape=box, label="s_sid\nextract sid"];
  "s_cs_len" [shape=box, label="s_cs_len\nextract cs_len", tooltip="cipher_suites: <2..2^16-2>, u16 list: nonzero and even.", href="#"];
  "s_cs_parity" [shape=box, label="s_cs_parity"];
  "s_cs" [shape=box, label="s_cs\nextract cs"];
  "s_comp_len" [shape=box, label="s_comp_len\nextract comp_len", tooltip="legacy_compression_methods: <1..2^8-1>.", href="#"];
  "s_comp" [shape=box, label="s_comp\nextract comp"];
  "s_ext_check" [shape=box, label="s_ext_check", tooltip="Extensions are OPTIONAL: a handshake body ending here is a\nlegal pre-TLS-1.2 ClientHello. One stray byte cannot hold the\nu16 extensions length.", href="#"];
  "s_ext_len" [shape=box, label="s_ext_len\nextract ext_len"];
  "s_tlv" [shape=box, label="s_tlv", tooltip="The TLV loop head: bounded by max_depth (sole termination\nauthority); 1..3 bytes cannot hold a type+length header.", href="#"];
  "s_ext" [shape=box, label="s_ext\nextract ext"];
  "s_skip" [shape=box, label="s_skip\nextract skip"];
  "s_sni" [shape=box, label="s_sni", tooltip="SNI descends two more regions deep: extension data, then the\nserver_name list — every length is checked exactly.", href="#"];
  "s_sni_list" [shape=box, label="s_sni_list\nextract sni_list"];
  "s_sni_entry" [shape=box, label="s_sni_entry\nextract sni_entry"];
  "s_host" [shape=box, label="s_host\nextract host", tooltip="Exact pops: hostname must fill the list AND the extension.", href="#"];
  "s_done" [shape=box, label="s_done", tooltip="Exact pops: extensions block, handshake body, record.", href="#"];
  "s_done_noext" [shape=box, label="s_done_noext"];
  "accept" [shape=doublecircle];
  "reject_0" [shape=diamond, label="reject:\nnot a handshake record"];
  "reject_1" [shape=diamond, label="reject:\nunsupported record version"];
  "reject_2" [shape=diamond, label="reject:\nnot a client hello"];
  "reject_3" [shape=diamond, label="reject:\nsession id too long"];
  "reject_4" [shape=diamond, label="reject:\nempty cipher suites"];
  "reject_5" [shape=diamond, label="reject:\nodd cipher suites length"];
  "reject_6" [shape=diamond, label="reject:\nempty compressions"];
  "reject_7" [shape=diamond, label="reject:\npartial extensions length"];
  "reject_8" [shape=diamond, label="reject:\npartial extension header"];
  "reject_9" [shape=diamond, label="reject:\nduplicate sni"];
  "reject_10" [shape=diamond, label="reject:\nunsupported sni name type"];
  "s_record" -> "s_recver" [label="record_hdr.ctype == 0x16"];
  "s_record" -> "reject_0" [label="default", style=dashed];
  "s_recver" -> "s_hs" [label="record_hdr.ver_major == 0x3"];
  "s_recver" -> "reject_1" [label="default", style=dashed];
  "s_hs" -> "s_fixed" [label="handshake_hdr.typ == 0x1"];
  "s_hs" -> "reject_2" [label="default", style=dashed];
  "s_fixed" -> "s_sid_len";
  "s_sid_len" -> "s_sid" [label="sid_len.slen in 0x0..=0x20"];
  "s_sid_len" -> "reject_3" [label="default", style=dashed];
  "s_sid" -> "s_cs_len";
  "s_cs_len" -> "reject_4" [label="cs_len.clen == 0x0"];
  "s_cs_len" -> "s_cs_parity" [label="default", style=dashed];
  "s_cs_parity" -> "reject_5" [label="meta.cs_odd == 0x1"];
  "s_cs_parity" -> "s_cs" [label="default", style=dashed];
  "s_cs" -> "s_comp_len";
  "s_comp_len" -> "reject_6" [label="comp_len.plen == 0x0"];
  "s_comp_len" -> "s_comp" [label="default", style=dashed];
  "s_comp" -> "s_ext_check";
  "s_ext_check" -> "s_done_noext" [label="(remaining() >> 3) == 0x0"];
  "s_ext_check" -> "reject_7" [label="(remaining() >> 3) == 0x1"];
  "s_ext_check" -> "s_ext_len" [label="default", style=dashed];
  "s_ext_len" -> "s_tlv";
  "s_tlv" -> "s_done" [label="(remaining() >> 3) == 0x0"];
  "s_tlv" -> "reject_8" [label="(remaining() >> 3) == 0x1"];
  "s_tlv" -> "reject_8" [label="(remaining() >> 3) == 0x2"];
  "s_tlv" -> "reject_8" [label="(remaining() >> 3) == 0x3"];
  "s_tlv" -> "s_ext" [label="default", style=dashed];
  "s_ext" -> "s_sni" [label="ext.typ == 0x0 && meta.seen_sni == 0x0"];
  "s_ext" -> "reject_9" [label="ext.typ == 0x0 && meta.seen_sni == 0x1"];
  "s_ext" -> "s_skip" [label="default", style=dashed];
  "s_skip" -> "s_tlv";
  "s_sni" -> "s_sni_list";
  "s_sni_list" -> "s_sni_entry";
  "s_sni_entry" -> "s_host" [label="sni_entry.ntype == 0x0"];
  "s_sni_entry" -> "reject_10" [label="default", style=dashed];
  "s_host" -> "s_tlv";
  "s_done" -> "accept";
  "s_done_noext" -> "accept";
}
