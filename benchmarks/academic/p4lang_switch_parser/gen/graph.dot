digraph "p4lang_switch_parser" {
  rankdir=TB;
  tooltip="The parser of classic switch.p4: `p4lang/switch` @ 7874f565,\nas-shipped feature defaults (p4features.h) + __TARGET_BMV2__.\nTwo layers (outer + inner_* twins after tunnel decap), the\nfabric-header family, INT over VXLAN-GPE, and sFlow.";
  node [fontname="Helvetica"];
  "parse_ethernet" [shape=box, label="parse_ethernet\nextract ethernet", tooltip="The entry state. The source's `start` is a bare `return\nparse_ethernet`; `start` is a reserved eDSL attribute, so the\nentry lands here directly.", href="#"];
  "parse_llc_header" [shape=box, label="parse_llc_header\nextract llc_header", tooltip="The source selects on (dsap, ssap) with the concatenated\nliterals 0xAAAA (SNAP) and 0xFEFE (CLNS/IS-IS), split here\nper 8-bit key.", href="#"];
  "parse_snap_header" [shape=box, label="parse_snap_header\nextract snap_header"];
  "parse_roce" [shape=box, label="parse_roce\nextract roce", tooltip="Unreachable under shipped defaults (its EtherType arm is\ncompiled out); transcribed as the source keeps it.", href="#"];
  "parse_fcoe" [shape=box, label="parse_fcoe\nextract fcoe", tooltip="Unreachable under shipped defaults (see parse_roce).", href="#"];
  "parse_vlan" [shape=box, label="parse_vlan\nextract vlan_tag_", tooltip="First 802.1Q tag: extracts vlan_tag_[0]. All three VLAN\nstates share one `vlan_tag_` instance (the gibb stack\npattern: a later extract overwrites).", href="#"];
  "parse_qinq" [shape=box, label="parse_qinq\nextract vlan_tag_"];
  "parse_qinq_vlan" [shape=box, label="parse_qinq_vlan\nextract vlan_tag_", tooltip="The inner 0x8100 tag of a QinQ pair: vlan_tag_[1] in the\nsource, the shared `vlan_tag_` instance here.", href="#"];
  "parse_mpls" [shape=box, label="parse_mpls\nextract mpls", tooltip="First label of the source's `mpls[3]` stack. The source is\none self-looping state extracting `mpls[next]`; the 3-entry\nstack bound is transcribed by unrolling (parse_mpls_2 and\nparse_mpls_3 are unroll-invented names).", href="#"];
  "parse_mpls_2" [shape=box, label="parse_mpls_2\nextract mpls"];
  "parse_mpls_3" [shape=box, label="parse_mpls_3\nextract mpls", tooltip="Third label: the stack is full. A fourth label (bos=0)\nwould overflow `mpls[3]` — a P4_14 parse exception,\ntranscribed as an explicit reject.", href="#"];
  "parse_mpls_bos" [shape=box, label="parse_mpls_bos\nlookahead ip_version_nibble", tooltip="Bottom of stack: the source peeks `current(0, 4)` —\ntranscribed 1:1 as a `lookahead()`; the continuations extract\nthe real full inner types over the peeked bits.", href="#"];
  "parse_mpls_inner_ipv4" [shape=box, label="parse_mpls_inner_ipv4", tooltip="Metadata-only in the source (tunnel type 9 = MPLS L3VPN),\nthen parse_inner_ipv4.", href="#"];
  "parse_mpls_inner_ipv6" [shape=box, label="parse_mpls_inner_ipv6", tooltip="Metadata-only in the source (tunnel type 12), then\nparse_inner_ipv6.", href="#"];
  "parse_vpls" [shape=box, label="parse_vpls", tooltip="Unreachable, extract-less `return ingress` in the source.", href="#"];
  "parse_pw" [shape=box, label="parse_pw", tooltip="Unreachable, extract-less `return ingress` in the source.", href="#"];
  "parse_ipv4" [shape=box, label="parse_ipv4\nextract ipv4", tooltip="The source keys on (fragOffset, ihl, protocol) with\nconcatenated literals (0x501 = frag 0 ++ ihl 5 ++ proto 1),\nsplit here per key width. The bare literals 2/88/89/103/112\ndecompose to ihl=0 — the routing-protocol arms match only\nihl==0 packets (a known switch.p4 quirk, kept). IPv4 is a\nfixed 20-byte extract: options are never consumed.", href="#"];
  "parse_ipv4_in_ip" [shape=box, label="parse_ipv4_in_ip", tooltip="Metadata-only in the source (tunnel type 3 = IP-in-IP).", href="#"];
  "parse_ipv6_in_ip" [shape=box, label="parse_ipv6_in_ip"];
  "parse_udp_v6" [shape=box, label="parse_udp_v6\nextract udp", tooltip="Unreachable under shipped defaults (parse_ipv6 dispatches\nUDP to parse_udp); extracts into the shared `udp` instance,\nas the source does.", href="#"];
  "parse_gre_v6" [shape=box, label="parse_gre_v6\nextract gre", tooltip="Unreachable twin of parse_gre with a single IPv4 arm.", href="#"];
  "parse_ipv6" [shape=box, label="parse_ipv6\nextract ipv6"];
  "parse_icmp" [shape=box, label="parse_icmp\nextract icmp", tooltip="Shared by IPv4 (proto 1) and IPv6 (proto 58). The masked\ntypeCode arms raise priority for ICMPv6 MLD and neighbor\ndiscovery.", href="#"];
  "parse_tcp" [shape=box, label="parse_tcp\nextract tcp", tooltip="A fixed 20-byte extract: dataOffset is read but no options\nare consumed (source behavior).", href="#"];
  "parse_roce_v2" [shape=box, label="parse_roce_v2\nextract roce_v2", tooltip="Unreachable under shipped defaults (no 4791 arm in\nparse_udp).", href="#"];
  "parse_udp" [shape=box, label="parse_udp\nextract udp"];
  "parse_gpe_int_header" [shape=box, label="parse_gpe_int_header\nextract vxlan_gpe_int_header"];
  "parse_int_header" [shape=box, label="parse_int_header\nextract int_header", tooltip="The source keys on (rsvd1, total_hop_cnt): exact 0x000\naccepts (no hops added yet), `0x000 mask 0xf00` (= rsvd1's\nlow four bits zero) enters the value stack, and a `0 mask 0`\ncatch-all accepts — deliberately shadowing the default, whose\ntarget parse_all_int_meta_value_heders the source keeps as a\ndeparser-graph aid (\"never transition to the following\nstate\").", href="#"];
  "parse_int_val" [shape=box, label="parse_int_val\nextract int_val", tooltip="The source's `int_val[24]` stack loop, kept as one cyclic\nstate: `max_depth` (not the stack size) bounds it here, so\nthe 24-entry cap is a depth budget, not a hard count.", href="#"];
  "parse_all_int_meta_value_heders" [shape=box, label="parse_all_int_meta_value_heders\nextract int_switch_id_header\nextract int_ingress_port_id_header\nextract int_hop_latency_header\nextract int_q_occupancy_header\nextract int_ingress_tstamp_header\nextract int_egress_port_id_header\nextract int_q_congestion_header\nextract int_egress_port_tx_utilization_header", tooltip="Semantically unreachable (see parse_int_header); the state\nname keeps the source's spelling, typo included.", href="#"];
  "parse_sctp" [shape=box, label="parse_sctp\nextract sctp", tooltip="Unreachable under shipped defaults (no proto-132 arm).", href="#"];
  "parse_gre" [shape=box, label="parse_gre\nextract gre", tooltip="The source selects on all nine GRE fields concatenated\n(32 bits); 0x20006558 splits to K=1 ++ proto 0x6558 (NVGRE),\nthe other arms are flagless proto values.", href="#"];
  "parse_gre_ipv4" [shape=box, label="parse_gre_ipv4", tooltip="Metadata-only in the source (tunnel type 2 = GRE).", href="#"];
  "parse_gre_ipv6" [shape=box, label="parse_gre_ipv6"];
  "parse_nvgre" [shape=box, label="parse_nvgre\nextract nvgre"];
  "parse_erspan_t3" [shape=box, label="parse_erspan_t3\nextract erspan_t3_header"];
  "parse_arp_rarp" [shape=box, label="parse_arp_rarp", tooltip="Extract-less in this configuration: ARP raises priority\nand parsing ends (the ARP header extract is compiled out).", href="#"];
  "parse_eompls" [shape=box, label="parse_eompls", tooltip="The source's eompls extract is commented out; the state\njumps straight to parse_inner_ethernet (the peeked nibble was\nnever consumed, so nothing needs re-assembling).", href="#"];
  "parse_vxlan" [shape=box, label="parse_vxlan\nextract vxlan"];
  "parse_vxlan_gpe" [shape=box, label="parse_vxlan_gpe\nextract vxlan_gpe", tooltip="next_proto 5 (INT shim) is written `0x05 mask 0xff` in the\nsource; kept as a masked arm.", href="#"];
  "parse_geneve" [shape=box, label="parse_geneve\nextract genv", tooltip="The source keys on (ver, optLen, protoType) with the single\nconcatenated arm 0x6558 (= 0 ++ 0 ++ TEB) and NO default: any\nother value is a P4_14 parse exception, transcribed as an\nexplicit reject.", href="#"];
  "parse_nsh" [shape=box, label="parse_nsh\nextract nsh\nextract nsh_context", tooltip="Unreachable under shipped defaults; extracts the NSH base\nand context headers back to back, as the source does.", href="#"];
  "parse_lisp" [shape=box, label="parse_lisp\nextract lisp\nlookahead ip_version_nibble", tooltip="Unreachable under shipped defaults. The source's second\n`current(0, 4)` site, transcribed 1:1: extract-then-peek in\none state, routing straight to the real inner-IP states.", href="#"];
  "parse_inner_ipv4" [shape=box, label="parse_inner_ipv4\nextract inner_ipv4"];
  "parse_inner_icmp" [shape=box, label="parse_inner_icmp\nextract inner_icmp"];
  "parse_inner_tcp" [shape=box, label="parse_inner_tcp\nextract inner_tcp"];
  "parse_inner_udp" [shape=box, label="parse_inner_udp\nextract inner_udp"];
  "parse_inner_sctp" [shape=box, label="parse_inner_sctp\nextract inner_sctp", tooltip="Unreachable under shipped defaults (see parse_sctp).", href="#"];
  "parse_inner_ipv6" [shape=box, label="parse_inner_ipv6\nextract inner_ipv6"];
  "parse_inner_ethernet" [shape=box, label="parse_inner_ethernet\nextract inner_ethernet"];
  "parse_trill" [shape=box, label="parse_trill\nextract trill", tooltip="Unreachable under shipped defaults.", href="#"];
  "parse_vntag" [shape=box, label="parse_vntag\nextract vntag", tooltip="Unreachable under shipped defaults.", href="#"];
  "parse_bfd" [shape=box, label="parse_bfd\nextract bfd", tooltip="Unreachable under shipped defaults.", href="#"];
  "parse_sflow" [shape=box, label="parse_sflow\nextract sflow"];
  "parse_fabric_header" [shape=box, label="parse_fabric_header\nextract fabric_header"];
  "parse_fabric_header_unicast" [shape=box, label="parse_fabric_header_unicast\nextract fabric_header_unicast"];
  "parse_fabric_header_multicast" [shape=box, label="parse_fabric_header_multicast\nextract fabric_header_multicast"];
  "parse_fabric_header_mirror" [shape=box, label="parse_fabric_header_mirror\nextract fabric_header_mirror"];
  "parse_fabric_header_cpu" [shape=box, label="parse_fabric_header_cpu\nextract fabric_header_cpu"];
  "parse_fabric_sflow_header" [shape=box, label="parse_fabric_sflow_header\nextract fabric_header_sflow"];
  "parse_fabric_payload_header" [shape=box, label="parse_fabric_payload_header\nextract fabric_payload_header", tooltip="The fabric payload re-enters the L2 dispatch — the same\nmap as parse_ethernet minus the fabric arm (no nesting).", href="#"];
  "parse_set_prio_med" [shape=box, label="parse_set_prio_med", tooltip="`intrinsic_metadata.priority = 3` in the source, then\ningress: parsing ends.", href="#"];
  "parse_set_prio_high" [shape=box, label="parse_set_prio_high", tooltip="`intrinsic_metadata.priority = 5` in the source.", href="#"];
  "parse_set_prio_max" [shape=box, label="parse_set_prio_max", tooltip="`intrinsic_metadata.priority = 7` in the source.", href="#"];
  "accept" [shape=doublecircle];
  "reject_0" [shape=diamond, label="reject:\na fourth MPLS label overflows the source's mpls[3] stack"];
  "reject_1" [shape=diamond, label="reject:\ngenv: only ver=0, optLen=0, protoType=TEB is parseable"];
  "parse_ethernet" -> "parse_llc_header" [label="ethernet.ether_type & 0xfe00 == 0x0"];
  "parse_ethernet" -> "parse_llc_header" [label="ethernet.ether_type & 0xfa00 == 0x0"];
  "parse_ethernet" -> "parse_fabric_header" [label="ethernet.ether_type == 0x9000"];
  "parse_ethernet" -> "parse_vlan" [label="ethernet.ether_type == 0x8100"];
  "parse_ethernet" -> "parse_qinq" [label="ethernet.ether_type == 0x9100"];
  "parse_ethernet" -> "parse_mpls" [label="ethernet.ether_type == 0x8847"];
  "parse_ethernet" -> "parse_ipv4" [label="ethernet.ether_type == 0x800"];
  "parse_ethernet" -> "parse_ipv6" [label="ethernet.ether_type == 0x86dd"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x806"];
  "parse_ethernet" -> "parse_set_prio_high" [label="ethernet.ether_type == 0x88cc"];
  "parse_ethernet" -> "parse_set_prio_high" [label="ethernet.ether_type == 0x8809"];
  "parse_ethernet" -> "accept" [label="default", style=dashed];
  "parse_llc_header" -> "parse_snap_header" [label="llc_header.dsap == 0xaa && llc_header.ssap == 0xaa"];
  "parse_llc_header" -> "parse_set_prio_med" [label="llc_header.dsap == 0xfe && llc_header.ssap == 0xfe"];
  "parse_llc_header" -> "accept" [label="default", style=dashed];
  "parse_snap_header" -> "parse_vlan" [label="snap_header.type_ == 0x8100"];
  "parse_snap_header" -> "parse_qinq" [label="snap_header.type_ == 0x9100"];
  "parse_snap_header" -> "parse_mpls" [label="snap_header.type_ == 0x8847"];
  "parse_snap_header" -> "parse_ipv4" [label="snap_header.type_ == 0x800"];
  "parse_snap_header" -> "parse_ipv6" [label="snap_header.type_ == 0x86dd"];
  "parse_snap_header" -> "parse_arp_rarp" [label="snap_header.type_ == 0x806"];
  "parse_snap_header" -> "parse_set_prio_high" [label="snap_header.type_ == 0x88cc"];
  "parse_snap_header" -> "parse_set_prio_high" [label="snap_header.type_ == 0x8809"];
  "parse_snap_header" -> "accept" [label="default", style=dashed];
  "parse_roce" -> "accept";
  "parse_fcoe" -> "accept";
  "parse_vlan" -> "parse_mpls" [label="vlan_tag_.ether_type == 0x8847"];
  "parse_vlan" -> "parse_ipv4" [label="vlan_tag_.ether_type == 0x800"];
  "parse_vlan" -> "parse_ipv6" [label="vlan_tag_.ether_type == 0x86dd"];
  "parse_vlan" -> "parse_arp_rarp" [label="vlan_tag_.ether_type == 0x806"];
  "parse_vlan" -> "parse_set_prio_high" [label="vlan_tag_.ether_type == 0x88cc"];
  "parse_vlan" -> "parse_set_prio_high" [label="vlan_tag_.ether_type == 0x8809"];
  "parse_vlan" -> "accept" [label="default", style=dashed];
  "parse_qinq" -> "parse_qinq_vlan" [label="vlan_tag_.ether_type == 0x8100"];
  "parse_qinq" -> "accept" [label="default", style=dashed];
  "parse_qinq_vlan" -> "parse_mpls" [label="vlan_tag_.ether_type == 0x8847"];
  "parse_qinq_vlan" -> "parse_ipv4" [label="vlan_tag_.ether_type == 0x800"];
  "parse_qinq_vlan" -> "parse_ipv6" [label="vlan_tag_.ether_type == 0x86dd"];
  "parse_qinq_vlan" -> "parse_arp_rarp" [label="vlan_tag_.ether_type == 0x806"];
  "parse_qinq_vlan" -> "parse_set_prio_high" [label="vlan_tag_.ether_type == 0x88cc"];
  "parse_qinq_vlan" -> "parse_set_prio_high" [label="vlan_tag_.ether_type == 0x8809"];
  "parse_qinq_vlan" -> "accept" [label="default", style=dashed];
  "parse_mpls" -> "parse_mpls_2" [label="mpls.bos == 0x0"];
  "parse_mpls" -> "parse_mpls_bos" [label="mpls.bos == 0x1"];
  "parse_mpls" -> "accept" [label="default", style=dashed];
  "parse_mpls_2" -> "parse_mpls_3" [label="mpls.bos == 0x0"];
  "parse_mpls_2" -> "parse_mpls_bos" [label="mpls.bos == 0x1"];
  "parse_mpls_2" -> "accept" [label="default", style=dashed];
  "parse_mpls_3" -> "reject_0" [label="mpls.bos == 0x0"];
  "parse_mpls_3" -> "parse_mpls_bos" [label="mpls.bos == 0x1"];
  "parse_mpls_3" -> "accept" [label="default", style=dashed];
  "parse_mpls_bos" -> "parse_mpls_inner_ipv4" [label="ip_version_nibble.v == 0x4"];
  "parse_mpls_bos" -> "parse_mpls_inner_ipv6" [label="ip_version_nibble.v == 0x6"];
  "parse_mpls_bos" -> "parse_eompls" [label="default", style=dashed];
  "parse_mpls_inner_ipv4" -> "parse_inner_ipv4";
  "parse_mpls_inner_ipv6" -> "parse_inner_ipv6";
  "parse_vpls" -> "accept";
  "parse_pw" -> "accept";
  "parse_ipv4" -> "parse_icmp" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x5 && ipv4.protocol == 0x1"];
  "parse_ipv4" -> "parse_tcp" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x5 && ipv4.protocol == 0x6"];
  "parse_ipv4" -> "parse_udp" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x5 && ipv4.protocol == 0x11"];
  "parse_ipv4" -> "parse_gre" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x5 && ipv4.protocol == 0x2f"];
  "parse_ipv4" -> "parse_ipv4_in_ip" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x5 && ipv4.protocol == 0x4"];
  "parse_ipv4" -> "parse_ipv6_in_ip" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x5 && ipv4.protocol == 0x29"];
  "parse_ipv4" -> "parse_set_prio_med" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x0 && ipv4.protocol == 0x2"];
  "parse_ipv4" -> "parse_set_prio_med" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x0 && ipv4.protocol == 0x58"];
  "parse_ipv4" -> "parse_set_prio_med" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x0 && ipv4.protocol == 0x59"];
  "parse_ipv4" -> "parse_set_prio_med" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x0 && ipv4.protocol == 0x67"];
  "parse_ipv4" -> "parse_set_prio_med" [label="ipv4.frag_offset == 0x0 && ipv4.ihl == 0x0 && ipv4.protocol == 0x70"];
  "parse_ipv4" -> "accept" [label="default", style=dashed];
  "parse_ipv4_in_ip" -> "parse_inner_ipv4";
  "parse_ipv6_in_ip" -> "parse_inner_ipv6";
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x43"];
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x44"];
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x222"];
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x223"];
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x208"];
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x209"];
  "parse_udp_v6" -> "parse_set_prio_med" [label="udp.dst_port == 0x7c1"];
  "parse_udp_v6" -> "accept" [label="default", style=dashed];
  "parse_gre_v6" -> "parse_gre_ipv4" [label="gre.c == 0x0 && gre.r == 0x0 && gre.k == 0x0 && gre.s == 0x0 && gre.strict == 0x0 && gre.recurse == 0x0 && gre.flags == 0x0 && gre.ver == 0x0 && gre.proto == 0x800"];
  "parse_gre_v6" -> "accept" [label="default", style=dashed];
  "parse_ipv6" -> "parse_icmp" [label="ipv6.next_hdr == 0x3a"];
  "parse_ipv6" -> "parse_tcp" [label="ipv6.next_hdr == 0x6"];
  "parse_ipv6" -> "parse_ipv4_in_ip" [label="ipv6.next_hdr == 0x4"];
  "parse_ipv6" -> "parse_udp" [label="ipv6.next_hdr == 0x11"];
  "parse_ipv6" -> "parse_gre" [label="ipv6.next_hdr == 0x2f"];
  "parse_ipv6" -> "parse_ipv6_in_ip" [label="ipv6.next_hdr == 0x29"];
  "parse_ipv6" -> "parse_set_prio_med" [label="ipv6.next_hdr == 0x58"];
  "parse_ipv6" -> "parse_set_prio_med" [label="ipv6.next_hdr == 0x59"];
  "parse_ipv6" -> "parse_set_prio_med" [label="ipv6.next_hdr == 0x67"];
  "parse_ipv6" -> "parse_set_prio_med" [label="ipv6.next_hdr == 0x70"];
  "parse_ipv6" -> "accept" [label="default", style=dashed];
  "parse_icmp" -> "parse_set_prio_med" [label="icmp.type_code & 0xfe00 == 0x8200"];
  "parse_icmp" -> "parse_set_prio_med" [label="icmp.type_code & 0xfc00 == 0x8400"];
  "parse_icmp" -> "parse_set_prio_med" [label="icmp.type_code & 0xff00 == 0x8800"];
  "parse_icmp" -> "accept" [label="default", style=dashed];
  "parse_tcp" -> "parse_set_prio_med" [label="tcp.dst_port == 0xb3"];
  "parse_tcp" -> "parse_set_prio_med" [label="tcp.dst_port == 0x27f"];
  "parse_tcp" -> "accept" [label="default", style=dashed];
  "parse_roce_v2" -> "accept";
  "parse_udp" -> "parse_vxlan" [label="udp.dst_port == 0x12b5"];
  "parse_udp" -> "parse_geneve" [label="udp.dst_port == 0x17c1"];
  "parse_udp" -> "parse_vxlan_gpe" [label="udp.dst_port == 0x12b6"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x43"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x44"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x222"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x223"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x208"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x209"];
  "parse_udp" -> "parse_set_prio_med" [label="udp.dst_port == 0x7c1"];
  "parse_udp" -> "parse_sflow" [label="udp.dst_port == 0x18c7"];
  "parse_udp" -> "accept" [label="default", style=dashed];
  "parse_gpe_int_header" -> "parse_int_header";
  "parse_int_header" -> "accept" [label="int_header.rsvd1 == 0x0 && int_header.total_hop_cnt == 0x0"];
  "parse_int_header" -> "parse_int_val" [label="int_header.rsvd1 & 0xf == 0x0 && int_header.total_hop_cnt & 0x0 == 0x0"];
  "parse_int_header" -> "accept" [label="int_header.rsvd1 & 0x0 == 0x0 && int_header.total_hop_cnt & 0x0 == 0x0"];
  "parse_int_header" -> "parse_all_int_meta_value_heders" [label="default", style=dashed];
  "parse_int_val" -> "parse_int_val" [label="int_val.bos == 0x0"];
  "parse_int_val" -> "parse_inner_ethernet" [label="int_val.bos == 0x1"];
  "parse_int_val" -> "accept" [label="default", style=dashed];
