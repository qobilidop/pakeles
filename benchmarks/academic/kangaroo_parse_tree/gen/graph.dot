digraph "kangaroo_parse_tree" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "parse_ethernet" [shape=box, label="parse_ethernet\nextract ethernet"];
  "parse_vlan_q1" [shape=box, label="parse_vlan_q1\nextract shim_tag", tooltip="First 802.1Q tag; \"nested 802.1q\" is its own shim in the\nprose, so exactly one more 802.1Q may follow.", href="#"];
  "parse_vlan_q2" [shape=box, label="parse_vlan_q2\nextract shim_tag", tooltip="The nested 802.1Q tag; a third is not in the prose's shim\nlist and falls to the default.", href="#"];
  "parse_recirc" [shape=box, label="parse_recirc\nextract shim_tag", tooltip="Cisco-internal recirculation tag (\"resirc\" in the paper\n[sic]); reached via a placeholder EtherType.", href="#"];
  "parse_service" [shape=box, label="parse_service\nextract shim_tag", tooltip="Cisco-internal service tag; placeholder EtherType.", href="#"];
  "parse_vlan_ad" [shape=box, label="parse_vlan_ad\nextract shim_tag"];
  "parse_ieee8021ah" [shape=box, label="parse_ieee8021ah\nextract ieee8021_ah"];
  "parse_mpls1" [shape=box, label="parse_mpls1\nextract mpls", tooltip="First of the four bounded MPLS labels (\"up to 4 MPLS\nheaders\"); dispatch mechanism borrowed from the Gibb suite\n(bos select + payload-nibble header).", href="#"];
  "parse_mpls2" [shape=box, label="parse_mpls2\nextract mpls"];
  "parse_mpls3" [shape=box, label="parse_mpls3\nextract mpls"];
  "parse_mpls4" [shape=box, label="parse_mpls4\nextract mpls", tooltip="Fourth label: the bound is exhausted, so bos=0 (a fifth\nlabel) falls to the default - not a recognized sequence.", href="#"];
  "parse_mpls_payload" [shape=box, label="parse_mpls_payload\nextract mpls_payload_nibble", tooltip="Bottom of stack: \"MPLS is followed by Ethernet, IPv4, or\nIPv6\". Nibble 0 is the EoMPLS discriminator here (no control\nword in this tree, unlike Gibb - see README).", href="#"];
  "parse_ethernet2" [shape=box, label="parse_ethernet2\nextract ethernet2", tooltip="The inner Ethernet after MPLS - terminal (the prose gives\nit no successors of its own).", href="#"];
  "parse_ipv4" [shape=box, label="parse_ipv4\nextract ipv4", tooltip="Single-key dispatch on protocol - the prose never mentions\nfragments (unlike the Gibb graphs' (fragOffset, protocol)).", href="#"];
  "parse_ipv4_rest" [shape=box, label="parse_ipv4_rest\nextract ipv4_rest"];
  "parse_ipv6" [shape=box, label="parse_ipv6\nextract ipv6"];
  "parse_ipv6_rest" [shape=box, label="parse_ipv6_rest\nextract ipv6_rest"];
  "parse_ipv6_ext" [shape=box, label="parse_ipv6_ext\nextract ipv6_ext_hdr", tooltip="\"an IPv6 extension header which, in turn, is followed by\nTCP, UDP, ESP or ICMPv6\" - one level.", href="#"];
  "parse_gre" [shape=box, label="parse_gre\nextract gre", tooltip="\"GRE can also be followed by IPv4/IPv6\" - a full inner IP\nheader, one tunnel level.", href="#"];
  "parse_ipv4_inner" [shape=box, label="parse_ipv4_inner\nextract ipv4", tooltip="The \"second IPv4 header\" (and GRE's inner IPv4): one\ntunnel level, so it dispatches L4 only - no further GRE or\nIP-in-IP.", href="#"];
  "parse_ipv6_inner" [shape=box, label="parse_ipv6_inner\nextract ipv6", tooltip="GRE's inner IPv6: L4 only, and no re-entry into the\nextension-header chain (one-level tunnel reading).", href="#"];
  "parse_tcp" [shape=box, label="parse_tcp\nextract tcp"];
  "parse_udp" [shape=box, label="parse_udp\nextract udp"];
  "parse_icmp" [shape=box, label="parse_icmp\nextract icmp"];
  "parse_icmpv6" [shape=box, label="parse_icmpv6\nextract icmpv6"];
  "parse_ipsec_esp" [shape=box, label="parse_ipsec_esp\nextract ipsec_esp"];
  "parse_arp_rarp" [shape=box, label="parse_arp_rarp\nextract arp_rarp", tooltip="Terminal - the prose lists ARP/RARP among the possible\nfollowers but gives them no successors (and no ARP body node,\nunlike the Gibb graphs).", href="#"];
  "accept" [shape=doublecircle];
  "parse_ethernet" -> "parse_vlan_q1" [label="ethernet.ether_type == 0x8100"];
  "parse_ethernet" -> "parse_recirc" [label="ethernet.ether_type == 0xf000"];
  "parse_ethernet" -> "parse_service" [label="ethernet.ether_type == 0xf100"];
  "parse_ethernet" -> "parse_ieee8021ah" [label="ethernet.ether_type == 0x88e7"];
  "parse_ethernet" -> "parse_vlan_ad" [label="ethernet.ether_type == 0x88a8"];
  "parse_ethernet" -> "parse_mpls1" [label="ethernet.ether_type == 0x8847"];
  "parse_ethernet" -> "parse_mpls1" [label="ethernet.ether_type == 0x8848"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x806"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x8035"];
  "parse_ethernet" -> "parse_ipv4" [label="ethernet.ether_type == 0x800"];
  "parse_ethernet" -> "parse_ipv6" [label="ethernet.ether_type == 0x86dd"];
  "parse_ethernet" -> "accept" [label="default", style=dashed];
  "parse_vlan_q1" -> "parse_vlan_q2" [label="shim_tag.ether_type == 0x8100"];
  "parse_vlan_q1" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8847"];
  "parse_vlan_q1" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8848"];
  "parse_vlan_q1" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x806"];
  "parse_vlan_q1" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x8035"];
  "parse_vlan_q1" -> "parse_ipv4" [label="shim_tag.ether_type == 0x800"];
  "parse_vlan_q1" -> "parse_ipv6" [label="shim_tag.ether_type == 0x86dd"];
  "parse_vlan_q1" -> "accept" [label="default", style=dashed];
  "parse_vlan_q2" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8847"];
  "parse_vlan_q2" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8848"];
  "parse_vlan_q2" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x806"];
  "parse_vlan_q2" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x8035"];
  "parse_vlan_q2" -> "parse_ipv4" [label="shim_tag.ether_type == 0x800"];
  "parse_vlan_q2" -> "parse_ipv6" [label="shim_tag.ether_type == 0x86dd"];
  "parse_vlan_q2" -> "accept" [label="default", style=dashed];
  "parse_recirc" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8847"];
  "parse_recirc" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8848"];
  "parse_recirc" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x806"];
  "parse_recirc" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x8035"];
  "parse_recirc" -> "parse_ipv4" [label="shim_tag.ether_type == 0x800"];
  "parse_recirc" -> "parse_ipv6" [label="shim_tag.ether_type == 0x86dd"];
  "parse_recirc" -> "accept" [label="default", style=dashed];
  "parse_service" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8847"];
  "parse_service" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8848"];
  "parse_service" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x806"];
  "parse_service" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x8035"];
  "parse_service" -> "parse_ipv4" [label="shim_tag.ether_type == 0x800"];
  "parse_service" -> "parse_ipv6" [label="shim_tag.ether_type == 0x86dd"];
  "parse_service" -> "accept" [label="default", style=dashed];
  "parse_vlan_ad" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8847"];
  "parse_vlan_ad" -> "parse_mpls1" [label="shim_tag.ether_type == 0x8848"];
  "parse_vlan_ad" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x806"];
  "parse_vlan_ad" -> "parse_arp_rarp" [label="shim_tag.ether_type == 0x8035"];
  "parse_vlan_ad" -> "parse_ipv4" [label="shim_tag.ether_type == 0x800"];
  "parse_vlan_ad" -> "parse_ipv6" [label="shim_tag.ether_type == 0x86dd"];
  "parse_vlan_ad" -> "accept" [label="default", style=dashed];
  "parse_ieee8021ah" -> "parse_mpls1" [label="ieee8021_ah.ether_type == 0x8847"];
  "parse_ieee8021ah" -> "parse_mpls1" [label="ieee8021_ah.ether_type == 0x8848"];
  "parse_ieee8021ah" -> "parse_arp_rarp" [label="ieee8021_ah.ether_type == 0x806"];
  "parse_ieee8021ah" -> "parse_arp_rarp" [label="ieee8021_ah.ether_type == 0x8035"];
  "parse_ieee8021ah" -> "parse_ipv4" [label="ieee8021_ah.ether_type == 0x800"];
  "parse_ieee8021ah" -> "parse_ipv6" [label="ieee8021_ah.ether_type == 0x86dd"];
  "parse_ieee8021ah" -> "accept" [label="default", style=dashed];
  "parse_mpls1" -> "parse_mpls2" [label="mpls.bos == 0x0"];
  "parse_mpls1" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls1" -> "accept" [label="default", style=dashed];
  "parse_mpls2" -> "parse_mpls3" [label="mpls.bos == 0x0"];
  "parse_mpls2" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls2" -> "accept" [label="default", style=dashed];
  "parse_mpls3" -> "parse_mpls4" [label="mpls.bos == 0x0"];
  "parse_mpls3" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls3" -> "accept" [label="default", style=dashed];
  "parse_mpls4" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls4" -> "accept" [label="default", style=dashed];
  "parse_mpls_payload" -> "parse_ethernet2" [label="mpls_payload_nibble.v == 0x0"];
  "parse_mpls_payload" -> "parse_ipv4_rest" [label="mpls_payload_nibble.v == 0x4"];
  "parse_mpls_payload" -> "parse_ipv6_rest" [label="mpls_payload_nibble.v == 0x6"];
  "parse_mpls_payload" -> "accept" [label="default", style=dashed];
  "parse_ethernet2" -> "accept";
  "parse_ipv4" -> "parse_icmp" [label="ipv4.protocol == 0x1"];
  "parse_ipv4" -> "parse_ipv4_inner" [label="ipv4.protocol == 0x4"];
  "parse_ipv4" -> "parse_tcp" [label="ipv4.protocol == 0x6"];
  "parse_ipv4" -> "parse_udp" [label="ipv4.protocol == 0x11"];
  "parse_ipv4" -> "parse_gre" [label="ipv4.protocol == 0x2f"];
  "parse_ipv4" -> "parse_ipsec_esp" [label="ipv4.protocol == 0x32"];
  "parse_ipv4" -> "accept" [label="default", style=dashed];
  "parse_ipv4_rest" -> "parse_icmp" [label="ipv4_rest.protocol == 0x1"];
  "parse_ipv4_rest" -> "parse_ipv4_inner" [label="ipv4_rest.protocol == 0x4"];
  "parse_ipv4_rest" -> "parse_tcp" [label="ipv4_rest.protocol == 0x6"];
  "parse_ipv4_rest" -> "parse_udp" [label="ipv4_rest.protocol == 0x11"];
  "parse_ipv4_rest" -> "parse_gre" [label="ipv4_rest.protocol == 0x2f"];
  "parse_ipv4_rest" -> "parse_ipsec_esp" [label="ipv4_rest.protocol == 0x32"];
  "parse_ipv4_rest" -> "accept" [label="default", style=dashed];
  "parse_ipv6" -> "parse_ipv6_ext" [label="ipv6.next_hdr == 0x0"];
  "parse_ipv6" -> "parse_icmp" [label="ipv6.next_hdr == 0x1"];
  "parse_ipv6" -> "parse_ipv4_inner" [label="ipv6.next_hdr == 0x4"];
  "parse_ipv6" -> "parse_tcp" [label="ipv6.next_hdr == 0x6"];
  "parse_ipv6" -> "parse_udp" [label="ipv6.next_hdr == 0x11"];
  "parse_ipv6" -> "parse_gre" [label="ipv6.next_hdr == 0x2f"];
  "parse_ipv6" -> "parse_ipsec_esp" [label="ipv6.next_hdr == 0x32"];
  "parse_ipv6" -> "accept" [label="default", style=dashed];
  "parse_ipv6_rest" -> "parse_ipv6_ext" [label="ipv6_rest.next_hdr == 0x0"];
  "parse_ipv6_rest" -> "parse_icmp" [label="ipv6_rest.next_hdr == 0x1"];
  "parse_ipv6_rest" -> "parse_ipv4_inner" [label="ipv6_rest.next_hdr == 0x4"];
  "parse_ipv6_rest" -> "parse_tcp" [label="ipv6_rest.next_hdr == 0x6"];
  "parse_ipv6_rest" -> "parse_udp" [label="ipv6_rest.next_hdr == 0x11"];
  "parse_ipv6_rest" -> "parse_gre" [label="ipv6_rest.next_hdr == 0x2f"];
  "parse_ipv6_rest" -> "parse_ipsec_esp" [label="ipv6_rest.next_hdr == 0x32"];
  "parse_ipv6_rest" -> "accept" [label="default", style=dashed];
  "parse_ipv6_ext" -> "parse_tcp" [label="ipv6_ext_hdr.next_hdr == 0x6"];
  "parse_ipv6_ext" -> "parse_udp" [label="ipv6_ext_hdr.next_hdr == 0x11"];
  "parse_ipv6_ext" -> "parse_ipsec_esp" [label="ipv6_ext_hdr.next_hdr == 0x32"];
  "parse_ipv6_ext" -> "parse_icmpv6" [label="ipv6_ext_hdr.next_hdr == 0x3a"];
  "parse_ipv6_ext" -> "accept" [label="default", style=dashed];
  "parse_gre" -> "parse_ipv4_inner" [label="gre.proto == 0x800"];
  "parse_gre" -> "parse_ipv6_inner" [label="gre.proto == 0x86dd"];
  "parse_gre" -> "accept" [label="default", style=dashed];
  "parse_ipv4_inner" -> "parse_icmp" [label="ipv4.protocol == 0x1"];
  "parse_ipv4_inner" -> "parse_tcp" [label="ipv4.protocol == 0x6"];
  "parse_ipv4_inner" -> "parse_udp" [label="ipv4.protocol == 0x11"];
  "parse_ipv4_inner" -> "parse_ipsec_esp" [label="ipv4.protocol == 0x32"];
  "parse_ipv4_inner" -> "accept" [label="default", style=dashed];
  "parse_ipv6_inner" -> "parse_icmp" [label="ipv6.next_hdr == 0x1"];
  "parse_ipv6_inner" -> "parse_tcp" [label="ipv6.next_hdr == 0x6"];
  "parse_ipv6_inner" -> "parse_udp" [label="ipv6.next_hdr == 0x11"];
  "parse_ipv6_inner" -> "parse_ipsec_esp" [label="ipv6.next_hdr == 0x32"];
  "parse_ipv6_inner" -> "accept" [label="default", style=dashed];
  "parse_tcp" -> "accept";
  "parse_udp" -> "accept";
  "parse_icmp" -> "accept";
  "parse_icmpv6" -> "accept";
  "parse_ipsec_esp" -> "accept";
  "parse_arp_rarp" -> "accept";
}
