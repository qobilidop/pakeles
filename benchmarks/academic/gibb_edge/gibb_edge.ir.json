                    "value": "0"
                  }
                ],
                "next": {
                  "state": "parse_mpls2"
                }
              },
              {
                "entries": [
                  {
                    "value": "1"
                  }
                ],
                "next": {
                  "state": "parse_payload_nibble"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "First of the two bounded MPLS labels (`max = 2` in the\nsource). The source's `map(bos, next-header)` peeks a 4-bit\npseudo-field from the NEXT header; transcribed by dispatching\non `bos` alone - bos=0 continues the stack with nothing else\nconsumed, bos=1 hands off to the nibble state."
        }
      },
