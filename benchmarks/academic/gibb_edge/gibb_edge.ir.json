              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "1"
                  }
                ],
                "next": {
                  "state": "parse_payload_nibble"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "Second MPLS label; a third (bos=0) falls to the default -\nbeyond the graph's bound is simply not a recognized\nsequence."
        }
      },
      {
        "name": "parse_payload_nibble",
        "extracts": [
          {
            "headerType": "mpls_payload_nibble"
          }
