                "entries": [
                  {
                    "value": "0"
                  }
                ],
                "next": {
                  "state": "parse_eompls_rest"
                }
              },
              {
                "entries": [
                  {
                    "value": "4"
                  }
                ],
                "next": {
                  "state": "parse_ipv4_rest"
                }
              },
              {
                "entries": [
                  {
                    "value": "6"
                  }
                ],
                "next": {
                  "state": "parse_ipv6_rest"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "One shared state for both MPLS depths: extract the first\nnibble of the payload, then continue with the matching\n`*Rest` header (b10000/b10100/b10110 in the source's map)."
        }
