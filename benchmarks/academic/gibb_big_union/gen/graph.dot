digraph "gibb_big_union" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "parse_ethernet" [shape=box, label="parse_ethernet\nextract ethernet"];
  "parse_vlan_q1" [shape=box, label="parse_vlan_q1\nextract vlan", tooltip="First 802.1Q tag. 802.1Q and 802.1ad share one two-tag\nbudget (the source's shared `max_var = vlan` counter), so a\nsecond tag of either entry continues at `parse_vlan_q2`.", href="#"];
  "parse_vlan_ad" [shape=box, label="parse_vlan_ad\nextract ieee8021_ad", tooltip="First tag, 802.1ad entry: followed only by an 802.1Q tag\n(spending the shared budget's second slot) or 802.1ah/PBB.", href="#"];
  "parse_vlan_q2" [shape=box, label="parse_vlan_q2\nextract vlan", tooltip="Second tag (either entry): the shared budget is exhausted,\nso further VLAN TPIDs fall to the default.", href="#"];
  "parse_ieee8021ah" [shape=box, label="parse_ieee8021ah\nextract ieee8021_ah"];
  "parse_mpls1" [shape=box, label="parse_mpls1\nextract mpls", tooltip="First of the five bounded MPLS labels (`max = 5`).", href="#"];
  "parse_mpls2" [shape=box, label="parse_mpls2\nextract mpls"];
  "parse_mpls3" [shape=box, label="parse_mpls3\nextract mpls"];
  "parse_mpls4" [shape=box, label="parse_mpls4\nextract mpls"];
  "parse_mpls5" [shape=box, label="parse_mpls5\nextract mpls", tooltip="Fifth label: the bound is exhausted, so bos=0 (a sixth\nlabel) falls to the default - not a recognized sequence.", href="#"];
  "parse_mpls_payload" [shape=box, label="parse_mpls_payload\nlookahead mpls_payload_nibble", tooltip="Bottom of stack: the source's 4-bit pseudo-field, extracted\nhere as a real header (see the module docstring).", href="#"];
  "parse_eompls" [shape=box, label="parse_eompls\nextract eompls"];
  "parse_ipv4" [shape=box, label="parse_ipv4\nextract ipv4"];
  "parse_ipv6" [shape=box, label="parse_ipv6\nextract ipv6"];
  "parse_icmp" [shape=box, label="parse_icmp\nextract icmp"];
  "parse_icmpv6" [shape=box, label="parse_icmpv6\nextract icmpv6"];
  "parse_tcp" [shape=box, label="parse_tcp\nextract tcp"];
  "parse_udp" [shape=box, label="parse_udp\nextract udp", tooltip="UDP dispatches VXLAN on dstPort 65535 - the source's\nmade-up value (it predates the 4789 assignment) [sic].", href="#"];
  "parse_vxlan" [shape=box, label="parse_vxlan\nextract vxlan"];
  "parse_sctp" [shape=box, label="parse_sctp\nextract sctp"];
  "parse_gre1" [shape=box, label="parse_gre1\nextract gre", tooltip="First of the three bounded GREs (`max = 3`); dispatch keys\non (K, proto) concatenated, so both arms require K=1.", href="#"];
  "parse_gre2" [shape=box, label="parse_gre2\nextract gre"];
  "parse_gre3" [shape=box, label="parse_gre3\nextract gre", tooltip="Third GRE: the bound is exhausted, so the nested-GRE arm\nfalls to the default.", href="#"];
  "parse_nv_gre_inner" [shape=box, label="parse_nv_gre_inner\nextract nv_gre_inner"];
  "parse_ipsec_esp" [shape=box, label="parse_ipsec_esp\nextract ipsec_esp"];
  "parse_ipsec_ah" [shape=box, label="parse_ipsec_ah\nextract ipsec_ah", tooltip="The source's AH map, transcribed as-is - it includes\nICMPv6 even when AH was reached off the IPv4 path.", href="#"];
  "parse_arp_rarp" [shape=box, label="parse_arp_rarp\nextract arp_rarp"];
  "parse_arp_rarp_ipv4" [shape=box, label="parse_arp_rarp_ipv4\nextract arp_rarp_ipv4"];
  "parse_ethernet2" [shape=box, label="parse_ethernet2\nextract ethernet2", tooltip="The inner Ethernet every tunnel bottoms out in - terminal\nin the source (its `ethernet2` node has no dispatch map).", href="#"];
  "accept" [shape=doublecircle];
  "parse_ethernet" -> "parse_vlan_q1" [label="ethernet.ether_type == 0x8100"];
  "parse_ethernet" -> "parse_vlan_q1" [label="ethernet.ether_type == 0x9100"];
  "parse_ethernet" -> "parse_vlan_q1" [label="ethernet.ether_type == 0x9200"];
  "parse_ethernet" -> "parse_vlan_q1" [label="ethernet.ether_type == 0x9300"];
  "parse_ethernet" -> "parse_vlan_ad" [label="ethernet.ether_type == 0x88a8"];
  "parse_ethernet" -> "parse_mpls1" [label="ethernet.ether_type == 0x8847"];
  "parse_ethernet" -> "parse_mpls1" [label="ethernet.ether_type == 0x8848"];
  "parse_ethernet" -> "parse_ipv4" [label="ethernet.ether_type == 0x800"];
  "parse_ethernet" -> "parse_ipv6" [label="ethernet.ether_type == 0x86dd"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x806"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x8035"];
  "parse_ethernet" -> "accept" [label="default", style=dashed];
  "parse_vlan_q1" -> "parse_vlan_q2" [label="vlan.ether_type == 0x8100"];
  "parse_vlan_q1" -> "parse_vlan_q2" [label="vlan.ether_type == 0x9100"];
  "parse_vlan_q1" -> "parse_vlan_q2" [label="vlan.ether_type == 0x9200"];
  "parse_vlan_q1" -> "parse_vlan_q2" [label="vlan.ether_type == 0x9300"];
  "parse_vlan_q1" -> "parse_mpls1" [label="vlan.ether_type == 0x8847"];
  "parse_vlan_q1" -> "parse_mpls1" [label="vlan.ether_type == 0x8848"];
  "parse_vlan_q1" -> "parse_ipv4" [label="vlan.ether_type == 0x800"];
  "parse_vlan_q1" -> "parse_ipv6" [label="vlan.ether_type == 0x86dd"];
  "parse_vlan_q1" -> "parse_arp_rarp" [label="vlan.ether_type == 0x806"];
  "parse_vlan_q1" -> "parse_arp_rarp" [label="vlan.ether_type == 0x8035"];
  "parse_vlan_q1" -> "accept" [label="default", style=dashed];
  "parse_vlan_ad" -> "parse_vlan_q2" [label="ieee8021_ad.ether_type == 0x8100"];
  "parse_vlan_ad" -> "parse_vlan_q2" [label="ieee8021_ad.ether_type == 0x9100"];
  "parse_vlan_ad" -> "parse_vlan_q2" [label="ieee8021_ad.ether_type == 0x9200"];
  "parse_vlan_ad" -> "parse_vlan_q2" [label="ieee8021_ad.ether_type == 0x9300"];
  "parse_vlan_ad" -> "parse_ieee8021ah" [label="ieee8021_ad.ether_type == 0x88e7"];
  "parse_vlan_ad" -> "accept" [label="default", style=dashed];
  "parse_vlan_q2" -> "parse_mpls1" [label="vlan.ether_type == 0x8847"];
  "parse_vlan_q2" -> "parse_mpls1" [label="vlan.ether_type == 0x8848"];
  "parse_vlan_q2" -> "parse_ipv4" [label="vlan.ether_type == 0x800"];
  "parse_vlan_q2" -> "parse_ipv6" [label="vlan.ether_type == 0x86dd"];
  "parse_vlan_q2" -> "parse_arp_rarp" [label="vlan.ether_type == 0x806"];
  "parse_vlan_q2" -> "parse_arp_rarp" [label="vlan.ether_type == 0x8035"];
  "parse_vlan_q2" -> "accept" [label="default", style=dashed];
  "parse_ieee8021ah" -> "parse_ethernet2";
  "parse_mpls1" -> "parse_mpls2" [label="mpls.bos == 0x0"];
  "parse_mpls1" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls1" -> "accept" [label="default", style=dashed];
  "parse_mpls2" -> "parse_mpls3" [label="mpls.bos == 0x0"];
  "parse_mpls2" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls2" -> "accept" [label="default", style=dashed];
  "parse_mpls3" -> "parse_mpls4" [label="mpls.bos == 0x0"];
  "parse_mpls3" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls3" -> "accept" [label="default", style=dashed];
  "parse_mpls4" -> "parse_mpls5" [label="mpls.bos == 0x0"];
  "parse_mpls4" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls4" -> "accept" [label="default", style=dashed];
  "parse_mpls5" -> "parse_mpls_payload" [label="mpls.bos == 0x1"];
  "parse_mpls5" -> "accept" [label="default", style=dashed];
  "parse_mpls_payload" -> "parse_eompls" [label="mpls_payload_nibble.v == 0x0"];
  "parse_mpls_payload" -> "parse_ipv4" [label="mpls_payload_nibble.v == 0x4"];
  "parse_mpls_payload" -> "parse_ipv6" [label="mpls_payload_nibble.v == 0x6"];
  "parse_mpls_payload" -> "accept" [label="default", style=dashed];
  "parse_eompls" -> "parse_ethernet2";
  "parse_ipv4" -> "parse_icmp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x1"];
  "parse_ipv4" -> "parse_tcp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x6"];
  "parse_ipv4" -> "parse_udp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x11"];
  "parse_ipv4" -> "parse_gre1" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x2f"];
  "parse_ipv4" -> "parse_ipsec_esp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x32"];
  "parse_ipv4" -> "parse_ipsec_ah" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x33"];
  "parse_ipv4" -> "parse_sctp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x84"];
  "parse_ipv4" -> "accept" [label="default", style=dashed];
  "parse_ipv6" -> "parse_icmpv6" [label="ipv6.next_hdr == 0x3a"];
  "parse_ipv6" -> "parse_tcp" [label="ipv6.next_hdr == 0x6"];
  "parse_ipv6" -> "parse_udp" [label="ipv6.next_hdr == 0x11"];
  "parse_ipv6" -> "parse_gre1" [label="ipv6.next_hdr == 0x2f"];
  "parse_ipv6" -> "parse_ipsec_esp" [label="ipv6.next_hdr == 0x32"];
  "parse_ipv6" -> "parse_ipsec_ah" [label="ipv6.next_hdr == 0x33"];
  "parse_ipv6" -> "parse_sctp" [label="ipv6.next_hdr == 0x84"];
  "parse_ipv6" -> "accept" [label="default", style=dashed];
  "parse_icmp" -> "accept";
  "parse_icmpv6" -> "accept";
  "parse_tcp" -> "accept";
  "parse_udp" -> "parse_vxlan" [label="udp.dst_port == 0xffff"];
  "parse_udp" -> "accept" [label="default", style=dashed];
  "parse_vxlan" -> "parse_ethernet2";
  "parse_sctp" -> "accept";
  "parse_gre1" -> "parse_nv_gre_inner" [label="gre.k == 0x1 && gre.proto == 0x6558"];
  "parse_gre1" -> "parse_gre2" [label="gre.k == 0x1 && gre.proto == 0x6559"];
  "parse_gre1" -> "accept" [label="default", style=dashed];
  "parse_gre2" -> "parse_nv_gre_inner" [label="gre.k == 0x1 && gre.proto == 0x6558"];
  "parse_gre2" -> "parse_gre3" [label="gre.k == 0x1 && gre.proto == 0x6559"];
  "parse_gre2" -> "accept" [label="default", style=dashed];
  "parse_gre3" -> "parse_nv_gre_inner" [label="gre.k == 0x1 && gre.proto == 0x6558"];
  "parse_gre3" -> "accept" [label="default", style=dashed];
  "parse_nv_gre_inner" -> "parse_ethernet2";
  "parse_ipsec_esp" -> "accept";
  "parse_ipsec_ah" -> "parse_icmp" [label="ipsec_ah.next_hdr == 0x1"];
  "parse_ipsec_ah" -> "parse_tcp" [label="ipsec_ah.next_hdr == 0x6"];
  "parse_ipsec_ah" -> "parse_udp" [label="ipsec_ah.next_hdr == 0x11"];
  "parse_ipsec_ah" -> "parse_gre1" [label="ipsec_ah.next_hdr == 0x2f"];
  "parse_ipsec_ah" -> "parse_icmpv6" [label="ipsec_ah.next_hdr == 0x3a"];
  "parse_ipsec_ah" -> "parse_sctp" [label="ipsec_ah.next_hdr == 0x84"];
  "parse_ipsec_ah" -> "accept" [label="default", style=dashed];
  "parse_arp_rarp" -> "parse_arp_rarp_ipv4" [label="arp_rarp.proto_type == 0x800"];
  "parse_arp_rarp" -> "accept" [label="default", style=dashed];
  "parse_arp_rarp_ipv4" -> "accept";
  "parse_ethernet2" -> "accept";
}
