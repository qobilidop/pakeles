digraph "gibb_datacenter" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "parse_ethernet" [shape=box, label="parse_ethernet\nextract ethernet"];
  "parse_vlan1" [shape=box, label="parse_vlan1\nextract vlan", tooltip="First of the two bounded VLAN tags (`max = 2` in the\nsource, drawn as two nodes in the paper's graphs); the tag\ndispatches exactly as Ethernet does.", href="#"];
  "parse_vlan2" [shape=box, label="parse_vlan2\nextract vlan", tooltip="Second VLAN tag; a third falls to the default - beyond the\ngraph's bound is simply not a recognized sequence.", href="#"];
  "parse_ipv4" [shape=box, label="parse_ipv4\nextract ipv4", tooltip="L4 dispatch keys on (frag_offset, protocol) concatenated -\nthe source's `map(fragOffset, protocol)`, so only first\nfragments dispatch.", href="#"];
  "parse_icmp" [shape=box, label="parse_icmp\nextract icmp"];
  "parse_tcp" [shape=box, label="parse_tcp\nextract tcp"];
  "parse_udp" [shape=box, label="parse_udp\nextract udp", tooltip="The VXLAN port is the source's 65535 [sic] - a made-up\nplaceholder that predates the IANA 4789 assignment.", href="#"];
  "parse_gre1" [shape=box, label="parse_gre1\nextract gre", tooltip="First of the three bounded GRE headers (`max = 3` in the\nsource). Dispatch keys on (K, proto) concatenated - the\nsource's map values 0x16558/0x16559 are (K=1, EtherType).", href="#"];
  "parse_gre2" [shape=box, label="parse_gre2\nextract gre"];
  "parse_gre3" [shape=box, label="parse_gre3\nextract gre", tooltip="Third GRE header; a fourth nesting falls to the default -\nbeyond the graph's bound is simply not a recognized\nsequence. The NVGRE arm stays.", href="#"];
  "parse_nv_gre_inner" [shape=box, label="parse_nv_gre_inner\nextract nv_gre_inner"];
  "parse_vxlan" [shape=box, label="parse_vxlan\nextract vxlan"];
  "parse_ethernet2" [shape=box, label="parse_ethernet2\nextract ethernet2", tooltip="The source's `ethernet2`: the inner (tunneled) Ethernet\nheader, terminal. Same layout as `Ethernet` - reused as a\nsecond instance.", href="#"];
  "parse_arp_rarp" [shape=box, label="parse_arp_rarp\nextract arp_rarp", tooltip="Only IPv4-protocol ARP/RARP has a recognized body.", href="#"];
  "parse_arp_rarp_ipv4" [shape=box, label="parse_arp_rarp_ipv4\nextract arp_rarp_ipv4"];
  "accept" [shape=doublecircle];
  "parse_ethernet" -> "parse_vlan1" [label="ethernet.ether_type == 0x8100"];
  "parse_ethernet" -> "parse_vlan1" [label="ethernet.ether_type == 0x9100"];
  "parse_ethernet" -> "parse_vlan1" [label="ethernet.ether_type == 0x9200"];
  "parse_ethernet" -> "parse_vlan1" [label="ethernet.ether_type == 0x9300"];
  "parse_ethernet" -> "parse_ipv4" [label="ethernet.ether_type == 0x800"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x806"];
  "parse_ethernet" -> "parse_arp_rarp" [label="ethernet.ether_type == 0x8035"];
  "parse_ethernet" -> "accept" [label="default", style=dashed];
  "parse_vlan1" -> "parse_vlan2" [label="vlan.ether_type == 0x8100"];
  "parse_vlan1" -> "parse_vlan2" [label="vlan.ether_type == 0x9100"];
  "parse_vlan1" -> "parse_vlan2" [label="vlan.ether_type == 0x9200"];
  "parse_vlan1" -> "parse_vlan2" [label="vlan.ether_type == 0x9300"];
  "parse_vlan1" -> "parse_ipv4" [label="vlan.ether_type == 0x800"];
  "parse_vlan1" -> "parse_arp_rarp" [label="vlan.ether_type == 0x806"];
  "parse_vlan1" -> "parse_arp_rarp" [label="vlan.ether_type == 0x8035"];
  "parse_vlan1" -> "accept" [label="default", style=dashed];
  "parse_vlan2" -> "parse_ipv4" [label="vlan.ether_type == 0x800"];
  "parse_vlan2" -> "parse_arp_rarp" [label="vlan.ether_type == 0x806"];
  "parse_vlan2" -> "parse_arp_rarp" [label="vlan.ether_type == 0x8035"];
  "parse_vlan2" -> "accept" [label="default", style=dashed];
  "parse_ipv4" -> "parse_icmp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x1"];
  "parse_ipv4" -> "parse_tcp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x6"];
  "parse_ipv4" -> "parse_udp" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x11"];
  "parse_ipv4" -> "parse_gre1" [label="ipv4.frag_offset == 0x0 && ipv4.protocol == 0x2f"];
  "parse_ipv4" -> "accept" [label="default", style=dashed];
  "parse_icmp" -> "accept";
  "parse_tcp" -> "accept";
  "parse_udp" -> "parse_vxlan" [label="udp.dst_port == 0xffff"];
  "parse_udp" -> "accept" [label="default", style=dashed];
  "parse_gre1" -> "parse_nv_gre_inner" [label="gre.k == 0x1 && gre.proto == 0x6558"];
  "parse_gre1" -> "parse_gre2" [label="gre.k == 0x1 && gre.proto == 0x6559"];
  "parse_gre1" -> "accept" [label="default", style=dashed];
  "parse_gre2" -> "parse_nv_gre_inner" [label="gre.k == 0x1 && gre.proto == 0x6558"];
  "parse_gre2" -> "parse_gre3" [label="gre.k == 0x1 && gre.proto == 0x6559"];
  "parse_gre2" -> "accept" [label="default", style=dashed];
  "parse_gre3" -> "parse_nv_gre_inner" [label="gre.k == 0x1 && gre.proto == 0x6558"];
  "parse_gre3" -> "accept" [label="default", style=dashed];
  "parse_nv_gre_inner" -> "parse_ethernet2";
  "parse_vxlan" -> "parse_ethernet2";
  "parse_ethernet2" -> "accept";
  "parse_arp_rarp" -> "parse_arp_rarp_ipv4" [label="arp_rarp.proto_type == 0x800"];
  "parse_arp_rarp" -> "accept" [label="default", style=dashed];
  "parse_arp_rarp_ipv4" -> "accept";
}
