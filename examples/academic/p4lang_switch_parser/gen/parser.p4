        pkt.extract(hdr.int_ingress_tstamp_header_s0);
        pkt.extract(hdr.int_egress_port_id_header_s0);
        pkt.extract(hdr.int_q_congestion_header_s0);
        pkt.extract(hdr.int_egress_port_tx_utilization_header_s0);
