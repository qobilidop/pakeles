            64w0 &&& 64w65024: st_parse_llc_header;
            64w0 &&& 64w64000: st_parse_llc_header;
            64w36864: st_parse_fabric_header;
            64w33024: st_parse_vlan;
            64w37120: st_parse_qinq;
            64w34887: st_parse_mpls;
            64w2048: st_parse_ipv4;
            64w34525: st_parse_ipv6;
            64w2054: st_parse_arp_rarp;
            64w35020: st_parse_set_prio_high;
            64w34825: st_parse_set_prio_high;
            default: accept;
        }
    }
    state st_parse_llc_header {
        pkt.extract(hdr.llc_header_s0);
        transition select((bit<64>)hdr.llc_header_s0.dsap, (bit<64>)hdr.llc_header_s0.ssap) {
            (64w170, 64w170): st_parse_snap_header;
            (64w254, 64w254): st_parse_set_prio_med;
            default: accept;
        }
    }
    state st_parse_snap_header {
        pkt.extract(hdr.snap_header_s0);
        transition select((bit<64>)hdr.snap_header_s0.type_) {
            64w33024: st_parse_vlan;
            64w37120: st_parse_qinq;
            64w34887: st_parse_mpls;
            64w2048: st_parse_ipv4;
            64w34525: st_parse_ipv6;
            64w2054: st_parse_arp_rarp;
            64w35020: st_parse_set_prio_high;
            64w34825: st_parse_set_prio_high;
            default: accept;
        }
    }
    state st_parse_roce {
        pkt.extract(hdr.roce_s0);
        transition accept;
    }
    state st_parse_fcoe {
        pkt.extract(hdr.fcoe_s0);
        transition accept;
    }
    state st_parse_vlan {
        pkt.extract(hdr.vlan_tag__s0.next);
        transition select((bit<64>)hdr.vlan_tag__s0.last.ether_type) {
            64w34887: st_parse_mpls;
            64w2048: st_parse_ipv4;
            64w34525: st_parse_ipv6;
            64w2054: st_parse_arp_rarp;
            64w35020: st_parse_set_prio_high;
            64w34825: st_parse_set_prio_high;
            default: accept;
        }
    }
    state st_parse_qinq {
        pkt.extract(hdr.vlan_tag__s0.next);
