    state st_parse_qinq_vlan {
        pkt.extract(hdr.vlan_tag__s0.next);
        transition select((bit<64>)hdr.vlan_tag__s0.last.ether_type) {
            64w34887: st_parse_mpls;
            64w2048: st_parse_ipv4;
            64w34525: st_parse_ipv6;
            64w2054: st_parse_arp_rarp;
            64w35020: st_parse_set_prio_high;
            64w34825: st_parse_set_prio_high;
            default: accept;
        }
    }
    state st_parse_mpls {
        pkt.extract(hdr.mpls_s0.next);
        transition select((bit<64>)hdr.mpls_s0.last.bos) {
            64w0: st_parse_mpls_2;
            64w1: st_parse_mpls_bos;
            default: accept;
        }
    }
    state st_parse_mpls_2 {
        pkt.extract(hdr.mpls_s0.next);
        transition select((bit<64>)hdr.mpls_s0.last.bos) {
            64w0: st_parse_mpls_3;
            64w1: st_parse_mpls_bos;
            default: accept;
        }
    }
    state st_parse_mpls_3 {
        pkt.extract(hdr.mpls_s0.next);
        transition select((bit<64>)hdr.mpls_s0.last.bos) {
            64w0: st__reject;
            64w1: st_parse_mpls_bos;
            default: accept;
        }
    }
    state st_parse_mpls_bos {
        pkt.extract(hdr.ip_version_nibble_s0.next);
        transition select((bit<64>)hdr.ip_version_nibble_s0.last.v) {
            64w4: st_parse_mpls_inner_ipv4;
            64w6: st_parse_mpls_inner_ipv6;
