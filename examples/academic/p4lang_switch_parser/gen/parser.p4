            (64w0, 64w0, 64w1, 64w0, 64w0, 64w0, 64w0, 64w0, 64w25944): st_parse_nvgre;
            (64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w2048): st_parse_gre_ipv4;
            (64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w34525): st_parse_gre_ipv6;
            (64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w0, 64w8939): st_parse_erspan_t3;
