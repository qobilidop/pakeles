    state st_parse_mpls_inner_ipv4 {
        pkt.extract(hdr.inner_ipv4_rest_s0);
        transition select((bit<64>)hdr.inner_ipv4_rest_s0.frag_offset, (bit<64>)hdr.inner_ipv4_rest_s0.ihl, (bit<64>)hdr.inner_ipv4_rest_s0.protocol) {
