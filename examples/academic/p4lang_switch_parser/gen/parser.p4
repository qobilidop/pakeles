        pkt.extract(hdr.ipv4_s0);
        transition select((bit<64>)hdr.ipv4_s0.frag_offset, (bit<64>)hdr.ipv4_s0.ihl, (bit<64>)hdr.ipv4_s0.protocol) {
            (64w0, 64w5, 64w1): st_parse_icmp;
            (64w0, 64w5, 64w6): st_parse_tcp;
            (64w0, 64w5, 64w17): st_parse_udp;
            (64w0, 64w5, 64w47): st_parse_gre;
            (64w0, 64w5, 64w4): st_parse_ipv4_in_ip;
            (64w0, 64w5, 64w41): st_parse_ipv6_in_ip;
            (64w0, 64w0, 64w2): st_parse_set_prio_med;
            (64w0, 64w0, 64w88): st_parse_set_prio_med;
            (64w0, 64w0, 64w89): st_parse_set_prio_med;
            (64w0, 64w0, 64w103): st_parse_set_prio_med;
            (64w0, 64w0, 64w112): st_parse_set_prio_med;
