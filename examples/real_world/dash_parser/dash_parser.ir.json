    "states": [
      {
        "name": "parse_u0_ethernet",
        "extracts": [
          {
            "headerType": "ethernet",
            "instance": "u0_ethernet"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "u0_ethernet",
                  "field": "ether_type"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "2048"
                  }
                ],
                "next": {
                  "state": "parse_u0_ipv4"
                }
              },
              {
                "entries": [
                  {
                    "value": "34525"
                  }
                ],
                "next": {
                  "state": "parse_u0_ipv6"
                }
              },
              {
                "entries": [
                  {
                    "value": "34669"
                  }
                ],
                "next": {
                  "state": "parse_dash_hdr"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "The source's `start` state (the eDSL reserves that name):\nu0 EtherType demux, incl. the DASH packet-metadata sentinel\n0x876d; every miss accepts."
        }
      },
      {
        "name": "parse_dash_hdr",
        "extracts": [
          {
            "headerType": "dash_packet_meta",
            "instance": "packet_meta"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "packet_meta",
                  "field": "packet_subtype"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "1"
                  }
                ],
                "next": {
                  "state": "parse_flow_key"
                }
              },
              {
                "entries": [
                  {
                    "value": "2"
                  }
                ],
                "next": {
                  "state": "parse_flow_key"
                }
              },
              {
                "entries": [
                  {
                    "value": "3"
                  }
                ],
                "next": {
                  "state": "parse_flow_key"
                }
              }
            ],
            "defaultTarget": {
              "state": "parse_customer_ethernet"
            }
          }
        },
        "annotations": {
          "doc": "The wire packet_meta overwrites start's defaults; the\nsubtype demux routes FLOW_{CREATE,UPDATE,DELETE} through\nflow_key (the source's first parser `if`), everything else\nstraight to the customer layer."
        }
      },
      {
        "name": "parse_flow_key",
        "extracts": [
          {
            "headerType": "flow_key"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "packet_meta",
                  "field": "packet_subtype"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "3"
                  }
                ],
                "next": {
                  "state": "parse_flow_data"
                }
              }
            ],
            "defaultTarget": {
              "state": "parse_customer_ethernet"
            }
          }
        },
        "annotations": {
          "doc": "CREATE/UPDATE stop at the key; DELETE carries flow_data\n(the source's second parser `if`, re-keyed on the already-\nextracted subtype)."
        }
