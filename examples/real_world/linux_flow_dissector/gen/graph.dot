digraph "linux_flow_dissector" {
  rankdir=TB;
  node [fontname="Helvetica"];
  "parse_ethernet" [shape=box, label="parse_ethernet\nextract ethernet"];
  "parse_vlan_ad" [shape=box, label="parse_vlan_ad\nextract vlan_ad", tooltip="Upstream PROG(VLAN), 802.1AD arm: the outer S-tag must be\nfollowed by exactly one 802.1Q C-tag.", href="#"];
  "parse_vlan_q" [shape=box, label="parse_vlan_q\nextract vlan_q", tooltip="Upstream PROG(VLAN), common tail: the final (or only) tag;\na further Q/AD tag is a kernel drop (no triple tagging, no\ndouble-Q).", href="#"];
  "parse_ipv4" [shape=box, label="parse_ipv4\nextract ipv4"];
  "parse_ipv6" [shape=box, label="parse_ipv6\nextract ipv6"];
  "parse_ipv6_opt" [shape=box, label="parse_ipv6_opt\nextract ext_opt", tooltip="Kernel PROG(IPV6OP): walk the option, dispatch on its own\nnext_header — HopByHop/DestOpts loop back (self-edge).", href="#"];
  "parse_ipip" [shape=box, label="parse_ipip", tooltip="Kernel parse_ip_proto encap arms (IPPROTO_IPIP / IPPROTO_IPV6,\ndefault flags: STOP_AT_ENCAP off): mark is_encap and re-enter\nthe state machine as the inner family — pure back edges, no\nheader read; the max_depth budget bounds the nesting.", href="#"];
  "parse_ip6ip" [shape=box, label="parse_ip6ip"];
  "parse_gre" [shape=box, label="parse_gre\nextract gre", tooltip="Kernel IPPROTO_GRE arm, step order is the crux: version != 0\nis an immediate BPF_OK — no thoff advance, no is_encap, the\noptional region never read. Only version 0 walks the C/K/S\noptionals (parse_gre_opt), sets is_encap, and dispatches.", href="#"];
  "parse_gre_opt" [shape=box, label="parse_gre_opt\nextract gre_opt", tooltip="TEB (0x6558) re-enters parse_ethernet itself: the kernel reads\nthe inner Ethernet and runs its full parse_eth_proto dispatcher,\nso inner VLAN/MPLS/IPvX all live.", href="#"];
  "parse_ipv6_frag" [shape=box, label="parse_ipv6_frag\nextract ext_frag", tooltip="Kernel PROG(IPV6FR) under default flags: read the fragment\nheader and stop (BPF_OK), always.", href="#"];
  "parse_mpls" [shape=box, label="parse_mpls\nextract mpls", tooltip="Upstream PROG(MPLS): read one label entry, stop, BPF_OK.", href="#"];
  "parse_tcp" [shape=box, label="parse_tcp\nextract tcp"];
  "parse_udp" [shape=box, label="parse_udp\nextract udp"];
  "accept" [shape=doublecircle];
  "reject_0" [shape=diamond, label="reject:\nunsupported ethertype"];
  "reject_1" [shape=diamond, label="reject:\n802.1AD must be followed by 802.1Q"];
  "reject_2" [shape=diamond, label="reject:\nvlan stacking beyond kernel depth"];
  "reject_3" [shape=diamond, label="reject:\nunsupported ip protocol"];
  "reject_4" [shape=diamond, label="reject:\nunsupported gre proto"];
  "parse_ethernet" -> "parse_ipv4" [label="ethernet.ethertype == 0x800"];
  "parse_ethernet" -> "parse_ipv6" [label="ethernet.ethertype == 0x86dd"];
  "parse_ethernet" -> "parse_vlan_q" [label="ethernet.ethertype == 0x8100"];
  "parse_ethernet" -> "parse_vlan_ad" [label="ethernet.ethertype == 0x88a8"];
  "parse_ethernet" -> "parse_mpls" [label="ethernet.ethertype == 0x8847"];
  "parse_ethernet" -> "parse_mpls" [label="ethernet.ethertype == 0x8848"];
  "parse_ethernet" -> "reject_0" [label="default", style=dashed];
  "parse_vlan_ad" -> "parse_vlan_q" [label="vlan_ad.encapsulated_proto == 0x8100"];
  "parse_vlan_ad" -> "reject_1" [label="default", style=dashed];
  "parse_vlan_q" -> "parse_ipv4" [label="vlan_q.encapsulated_proto == 0x800"];
  "parse_vlan_q" -> "parse_ipv6" [label="vlan_q.encapsulated_proto == 0x86dd"];
  "parse_vlan_q" -> "parse_mpls" [label="vlan_q.encapsulated_proto == 0x8847"];
  "parse_vlan_q" -> "parse_mpls" [label="vlan_q.encapsulated_proto == 0x8848"];
  "parse_vlan_q" -> "reject_2" [label="vlan_q.encapsulated_proto == 0x8100"];
  "parse_vlan_q" -> "reject_2" [label="vlan_q.encapsulated_proto == 0x88a8"];
  "parse_vlan_q" -> "reject_0" [label="default", style=dashed];
  "parse_ipv4" -> "parse_ipip" [label="ipv4.protocol == 0x4"];
  "parse_ipv4" -> "parse_tcp" [label="ipv4.protocol == 0x6"];
  "parse_ipv4" -> "parse_udp" [label="ipv4.protocol == 0x11"];
  "parse_ipv4" -> "parse_ip6ip" [label="ipv4.protocol == 0x29"];
  "parse_ipv4" -> "parse_gre" [label="ipv4.protocol == 0x2f"];
  "parse_ipv4" -> "reject_3" [label="default", style=dashed];
  "parse_ipv6" -> "parse_ipv6_opt" [label="ipv6.next_header == 0x0"];
  "parse_ipv6" -> "parse_ipv6_opt" [label="ipv6.next_header == 0x3c"];
  "parse_ipv6" -> "parse_ipv6_frag" [label="ipv6.next_header == 0x2c"];
  "parse_ipv6" -> "parse_ipip" [label="ipv6.next_header == 0x4"];
  "parse_ipv6" -> "parse_tcp" [label="ipv6.next_header == 0x6"];
  "parse_ipv6" -> "parse_udp" [label="ipv6.next_header == 0x11"];
  "parse_ipv6" -> "parse_ip6ip" [label="ipv6.next_header == 0x29"];
  "parse_ipv6" -> "parse_gre" [label="ipv6.next_header == 0x2f"];
  "parse_ipv6" -> "reject_3" [label="default", style=dashed];
  "parse_ipv6_opt" -> "parse_ipv6_opt" [label="ext_opt.next_header == 0x0"];
  "parse_ipv6_opt" -> "parse_ipv6_opt" [label="ext_opt.next_header == 0x3c"];
  "parse_ipv6_opt" -> "parse_ipv6_frag" [label="ext_opt.next_header == 0x2c"];
  "parse_ipv6_opt" -> "parse_ipip" [label="ext_opt.next_header == 0x4"];
  "parse_ipv6_opt" -> "parse_tcp" [label="ext_opt.next_header == 0x6"];
  "parse_ipv6_opt" -> "parse_udp" [label="ext_opt.next_header == 0x11"];
  "parse_ipv6_opt" -> "parse_ip6ip" [label="ext_opt.next_header == 0x29"];
  "parse_ipv6_opt" -> "parse_gre" [label="ext_opt.next_header == 0x2f"];
  "parse_ipv6_opt" -> "reject_3" [label="default", style=dashed];
  "parse_ipip" -> "parse_ipv4";
  "parse_ip6ip" -> "parse_ipv6";
  "parse_gre" -> "parse_gre_opt" [label="gre.version == 0x0"];
  "parse_gre" -> "accept" [label="default", style=dashed];
  "parse_gre_opt" -> "parse_ipv4" [label="gre.proto == 0x800"];
  "parse_gre_opt" -> "parse_ipv6" [label="gre.proto == 0x86dd"];
  "parse_gre_opt" -> "parse_ethernet" [label="gre.proto == 0x6558"];
  "parse_gre_opt" -> "reject_4" [label="default", style=dashed];
  "parse_ipv6_frag" -> "accept";
  "parse_mpls" -> "accept";
  "parse_tcp" -> "accept";
  "parse_udp" -> "accept";
}
