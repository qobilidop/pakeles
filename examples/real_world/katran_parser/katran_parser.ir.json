{
  "irVersion": "0.1.0",
  "parser": {
    "name": "katran_parser",
    "headerTypes": [
      {
        "name": "ethernet",
        "fields": [
          {
            "name": "dst",
            "width": {
              "bits": 48
            },
            "display": {
              "name": "Destination",
              "format": "DISPLAY_FORMAT_ETHER"
            }
          },
          {
            "name": "src",
            "width": {
              "bits": 48
            },
            "display": {
              "name": "Source",
              "format": "DISPLAY_FORMAT_ETHER"
            }
          },
          {
            "name": "ethertype",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Type",
              "format": "DISPLAY_FORMAT_HEX",
              "valueLabels": [
                {
                  "value": "2048",
                  "label": "IPv4"
                },
                {
                  "value": "2054",
                  "label": "ARP"
                },
                {
                  "value": "34525",
                  "label": "IPv6"
                }
              ]
            }
          }
        ]
      },
      {
        "name": "ipv4",
        "fields": [
          {
            "name": "version",
            "width": {
              "bits": 4
            },
            "display": {
              "name": "Version",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "ihl",
            "width": {
              "bits": 4
            },
            "display": {
              "name": "Header Length",
              "format": "DISPLAY_FORMAT_DEC",
              "doc": "katran drops ihl != 5 (no options)"
            }
          },
          {
            "name": "dscp",
            "width": {
              "bits": 6
            },
            "display": {
              "name": "DSCP",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "ecn",
            "width": {
              "bits": 2
            },
            "display": {
              "name": "ECN",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "total_len",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Total Length",
              "format": "DISPLAY_FORMAT_DEC",
              "doc": "pkt_bytes, never validated by katran"
            }
          },
          {
            "name": "id",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Identification",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "flags_res_df",
            "width": {
              "bits": 2
            },
            "display": {
              "name": "Reserved/DF",
              "format": "DISPLAY_FORMAT_HEX",
              "doc": "outside katran's 0x3FFF fragment mask"
            }
          },
          {
            "name": "mf_frag_off",
            "width": {
              "bits": 14
            },
            "display": {
              "name": "MF + Fragment Offset",
              "format": "DISPLAY_FORMAT_HEX",
              "doc": "katran drops if != 0"
            }
          },
          {
            "name": "ttl",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Time to Live",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "protocol",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Protocol",
              "format": "DISPLAY_FORMAT_DEC",
              "valueLabels": [
                {
                  "value": "1",
                  "label": "ICMP"
                },
                {
                  "value": "4",
                  "label": "IPIP"
                },
                {
                  "value": "6",
                  "label": "TCP"
                },
                {
                  "value": "17",
                  "label": "UDP"
                },
                {
                  "value": "41",
                  "label": "IPv6-in-IP"
                },
                {
                  "value": "58",
                  "label": "ICMPv6"
                }
              ]
            }
          },
          {
            "name": "checksum",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Header Checksum",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "src",
            "width": {
              "bits": 32
            },
            "display": {
              "name": "Source Address",
              "format": "DISPLAY_FORMAT_IPV4"
            }
          },
          {
            "name": "dst",
            "width": {
              "bits": 32
            },
            "display": {
              "name": "Destination Address",
              "format": "DISPLAY_FORMAT_IPV4"
            }
          }
        ]
      },
      {
        "name": "ipv6",
        "fields": [
          {
            "name": "version",
            "width": {
              "bits": 4
            },
            "display": {
              "name": "Version",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "traffic_class",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Traffic Class",
              "format": "DISPLAY_FORMAT_HEX",
              "doc": "katran tos = this byte"
            }
          },
          {
            "name": "flow_label",
            "width": {
              "bits": 20
            },
            "display": {
              "name": "Flow Label",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "payload_length",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Payload Length",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "next_header",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Next Header",
              "format": "DISPLAY_FORMAT_DEC",
              "valueLabels": [
                {
                  "value": "1",
                  "label": "ICMP"
                },
                {
                  "value": "4",
                  "label": "IPIP"
                },
                {
                  "value": "6",
                  "label": "TCP"
                },
                {
                  "value": "17",
                  "label": "UDP"
                },
                {
                  "value": "41",
                  "label": "IPv6-in-IP"
                },
                {
                  "value": "58",
                  "label": "ICMPv6"
                }
              ]
            }
          },
          {
            "name": "hop_limit",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Hop Limit",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "src",
            "width": {
              "byteLen": {
                "constant": "16"
              }
            }
          },
          {
            "name": "dst",
            "width": {
              "byteLen": {
                "constant": "16"
              }
            }
          }
        ]
      },
      {
        "name": "icmp",
        "fields": [
          {
            "name": "type",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Type",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "code",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Code",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "checksum",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Checksum",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "rest",
            "width": {
              "bits": 32
            },
            "display": {
              "name": "Rest of Header",
              "format": "DISPLAY_FORMAT_HEX"
            }
          }
        ]
      },
      {
        "name": "tcp",
        "fields": [
          {
            "name": "sport",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Source Port",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "dport",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Destination Port",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "seq",
            "width": {
              "bits": 32
            },
            "display": {
              "name": "Sequence Number",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "ack",
            "width": {
              "bits": 32
            },
            "display": {
              "name": "Acknowledgment Number",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "data_offset",
            "width": {
              "bits": 4
            },
            "display": {
              "name": "Data Offset",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "reserved",
            "width": {
              "bits": 4
            },
            "display": {
              "name": "Reserved",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "flags",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Flags",
              "format": "DISPLAY_FORMAT_HEX",
              "doc": "katran lifts SYN (0x02) and RST (0x04)"
            }
          },
          {
            "name": "window",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Window",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "checksum",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Checksum",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "urgent",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Urgent Pointer",
              "format": "DISPLAY_FORMAT_DEC"
            }
          }
        ]
      },
      {
        "name": "udp",
        "fields": [
          {
            "name": "sport",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Source Port",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "dport",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Destination Port",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "length",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Length",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "checksum",
            "width": {
              "bits": 16
            },
            "display": {
              "name": "Checksum",
              "format": "DISPLAY_FORMAT_HEX"
            }
          }
        ]
      }
    ],
    "states": [
      {
        "name": "parse_ethernet",
        "extracts": [
          {
            "headerType": "ethernet"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "ethernet",
                  "field": "ethertype"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "2048"
                  }
                ],
                "next": {
                  "state": "parse_ipv4"
                }
              },
              {
                "entries": [
                  {
                    "value": "34525"
                  }
                ],
                "next": {
                  "state": "parse_ipv6"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "XDP entry: EtherType demux, no VLAN/MPLS. Non-IP (incl. ARP)\naccepts as XDP_PASS without entering the parser."
        }
      },
      {
        "name": "parse_ipv4",
        "extracts": [
          {
            "headerType": "ipv4"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "ipv4",
                  "field": "ihl"
                }
              },
              {
                "field": {
                  "header": "ipv4",
                  "field": "mf_frag_off"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "5"
                  },
                  {
                    "value": "0"
                  }
                ],
                "next": {
                  "state": "parse_ipv4_proto"
                }
              }
            ],
            "defaultTarget": {
              "reject": {
                "reason": "ipv4 ihl!=5 or fragmented"
              }
            }
          }
        },
        "annotations": {
          "doc": "parse_l3_headers v4: ihl != 5 or any fragment -> XDP_DROP."
        }
      },
      {
        "name": "parse_ipv4_proto",
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "ipv4",
                  "field": "protocol"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "1"
                  }
                ],
                "next": {
                  "state": "parse_icmp"
                }
              },
              {
                "entries": [
                  {
                    "value": "6"
                  }
                ],
                "next": {
                  "state": "parse_tcp"
                }
              },
              {
                "entries": [
                  {
                    "value": "17"
                  }
                ],
                "next": {
                  "state": "parse_udp"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "Proto dispatch (no extract): ICMP inner, TCP, UDP, else PASS."
        }
      },
      {
        "name": "parse_ipv6",
        "extracts": [
          {
            "headerType": "ipv6"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "ipv6",
                  "field": "next_header"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "44"
                  }
                ],
                "next": {
                  "reject": {
                    "reason": "ipv6 fragment"
                  }
                }
              },
              {
                "entries": [
                  {
                    "value": "58"
                  }
                ],
                "next": {
                  "state": "parse_icmp6"
                }
              },
              {
                "entries": [
                  {
                    "value": "6"
                  }
                ],
                "next": {
                  "state": "parse_tcp"
                }
              },
              {
                "entries": [
                  {
                    "value": "17"
                  }
                ],
                "next": {
                  "state": "parse_udp"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "parse_l3_headers v6: Fragment nexthdr -> DROP; ICMPv6 ->\ninner; no extension-header walk (any other nexthdr is the\nL4 proto). TCP/UDP dispatch, else PASS."
        }
      },
      {
        "name": "parse_icmp",
        "extracts": [
          {
            "headerType": "icmp",
            "instance": "icmp"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "icmp",
                  "field": "type"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "3"
                  }
                ],
                "next": {
                  "state": "parse_inner_ipv4"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "parse_icmp (v4): echo (8) accepts [-> XDP_TX]; DEST_UNREACH\n(3) parses the inner packet; any other type accepts [PASS]."
        }
      },
      {
        "name": "parse_icmp6",
        "extracts": [
          {
            "headerType": "icmp",
            "instance": "icmp"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "icmp",
                  "field": "type"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "1"
                  }
                ],
                "next": {
                  "state": "parse_inner_ipv6"
                }
              },
              {
                "entries": [
                  {
                    "value": "2"
                  }
                ],
                "next": {
                  "state": "parse_inner_ipv6"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "annotations": {
          "doc": "parse_icmpv6: echo (128) accepts [TX]; DEST_UNREACH (1) /\nPKT_TOOBIG (2) parse inner; else PASS."
        }
      },
      {
        "name": "parse_inner_ipv4",
        "extracts": [
          {
            "headerType": "ipv4",
            "instance": "inner_ipv4"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "inner_ipv4",
                  "field": "ihl"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "5"
                  }
                ],
                "next": {
                  "state": "parse_inner_ipv4_proto"
                }
              }
            ],
            "defaultTarget": {
              "reject": {
                "reason": "inner ipv4 ihl!=5"
              }
            }
          }
        },
        "assigns": [
          {
            "metadata": "is_icmp",
            "value": {
              "constant": "1"
            }
          }
        ],
        "annotations": {
          "doc": "Inner v4 (ICMP error payload): ihl != 5 -> DROP; no frag\ncheck (katran's parse_icmp doesn't). is_icmp marks the\ninversion for the projection."
        }
      },
      {
        "name": "parse_inner_ipv4_proto",
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "inner_ipv4",
                  "field": "protocol"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "6"
                  }
                ],
                "next": {
                  "state": "parse_tcp"
                }
              },
              {
                "entries": [
                  {
                    "value": "17"
                  }
                ],
                "next": {
                  "state": "parse_udp"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        }
      },
      {
        "name": "parse_inner_ipv6",
        "extracts": [
          {
            "headerType": "ipv6"
          }
        ],
        "transition": {
          "select": {
            "keys": [
              {
                "field": {
                  "header": "ipv6",
                  "field": "next_header"
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "6"
                  }
                ],
                "next": {
                  "state": "parse_tcp"
                }
              },
              {
                "entries": [
                  {
                    "value": "17"
                  }
                ],
                "next": {
                  "state": "parse_udp"
                }
              }
            ],
            "defaultTarget": {
              "accept": {}
            }
          }
        },
        "assigns": [
          {
            "metadata": "is_icmp",
            "value": {
              "constant": "1"
            }
          }
        ],
        "annotations": {
          "doc": "Inner v6: nexthdr taken directly (no frag/ext check in\nparse_icmpv6). TCP/UDP else PASS. Reuses the `ipv6` instance\n(its 128-bit addresses are var_bytes, which the IR cannot carry\nunder two instance names); the projection reads the LAST ipv6\nunder `is_icmp`, so the inner addresses win on the ICMP path\nexactly as katran records them."
        }
      },
      {
        "name": "parse_tcp",
        "extracts": [
          {
            "headerType": "tcp"
          }
        ],
        "transition": {
          "direct": {
            "accept": {}
          }
        },
        "annotations": {
          "doc": "Shared L4 terminal (outer or inner): the projection lifts\nports (swapped under is_icmp) and TCP SYN/RST flags."
        }
      },
      {
        "name": "parse_udp",
        "extracts": [
          {
            "headerType": "udp"
          }
        ],
        "transition": {
          "direct": {
            "accept": {}
          }
        }
      }
    ],
    "startState": "parse_ethernet",
    "maxDepth": 8,
    "metadata": [
      {
        "name": "is_icmp",
        "bits": 1,
        "display": {
          "name": "ICMP inner",
          "format": "DISPLAY_FORMAT_DEC",
          "doc": "set on the ICMP error inner-packet path; drives the flow src/dst/port inversion"
        }
      }
    ]
  }
}