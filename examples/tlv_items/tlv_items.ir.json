{
  "irVersion": "0.2.0",
  "parser": {
    "name": "tlv_items",
    "headerTypes": [
      {
        "name": "total_len",
        "fields": [
          {
            "name": "total",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Total Length",
              "format": "DISPLAY_FORMAT_DEC",
              "doc": "bytes of TLV items that follow"
            }
          }
        ]
      },
      {
        "name": "item",
        "fields": [
          {
            "name": "kind",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Kind",
              "format": "DISPLAY_FORMAT_HEX"
            }
          },
          {
            "name": "ln",
            "width": {
              "bits": 8
            },
            "display": {
              "name": "Length",
              "format": "DISPLAY_FORMAT_DEC"
            }
          },
          {
            "name": "val",
            "width": {
              "bitLen": {
                "bin": {
                  "op": "BIN_OP_KIND_MUL",
                  "lhs": {
                    "field": {
                      "header": "item",
                      "field": "ln"
                    }
                  },
                  "rhs": {
                    "constant": "8"
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "states": [
      {
        "name": "parse_total",
        "extracts": [
          {
            "headerType": "total_len"
          }
        ],
        "transition": {
          "direct": {
            "state": "tlv_loop"
          }
        },
        "regionOps": [
          {
            "push": {
              "bin": {
                "op": "BIN_OP_KIND_MUL",
                "lhs": {
                  "field": {
                    "header": "total_len",
                    "field": "total"
                  }
                },
                "rhs": {
                  "constant": "8"
                }
              }
            }
          }
        ]
      },
      {
        "name": "tlv_loop",
        "transition": {
          "select": {
            "keys": [
              {
                "bin": {
                  "op": "BIN_OP_KIND_SHR",
                  "lhs": {
                    "remaining": {}
                  },
                  "rhs": {
                    "constant": "3"
                  }
                }
              }
            ],
            "arms": [
              {
                "entries": [
                  {
                    "value": "0"
                  }
                ],
                "next": {
                  "state": "close"
                }
              }
            ],
            "defaultTarget": {
              "state": "parse_item"
            }
          }
        },
        "annotations": {
          "doc": "Loop head: region exhausted -> close; else another item."
        }
      },
      {
        "name": "parse_item",
        "extracts": [
          {
            "headerType": "item"
          }
        ],
        "transition": {
          "direct": {
            "state": "tlv_loop"
          }
        }
      },
      {
        "name": "close",
        "transition": {
          "direct": {
            "accept": {}
          }
        },
        "regionOps": [
          {
            "pop": {}
          }
        ],
        "annotations": {
          "doc": "Exact-mode pop: trailing bytes inside the region reject."
        }
      }
    ],
    "startState": "parse_total",
    "maxDepth": 8
  }
}