/target
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/

# Generated conformance suites (churn on every IR/testgen change; regenerate
# with ./dev.sh scripts/gen-examples.sh). Re-committed when the codebase stabilizes.
examples/*/*/conformance/vectors.json
examples/*/*/conformance/vectors.pcap

# symex perf bench outputs (baselines, inventories)
/.bench/

# Factory/spike build outputs (never committed; see the third_party/
# licensing rule for why katran sources are fetch-only)
examples/real_world/*/factory/build/
examples/real_world/*/spike/build/
examples/real_world/*/factory/witnesses.txt
/examples/real_world/tls_clienthello/factory/target/
examples/real_world/tls_clienthello/factory/witnesses.golden.json
